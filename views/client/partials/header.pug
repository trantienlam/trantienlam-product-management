include ../mixins/sub-menu.pug

header.header 
  .container 
    .row.align-items-center 
      .col-3  
        .inner-logo 
          a(href="/")
            img(src=settingGeneral.logo, alt="Logo")

      
      .col-5
        form.header-search(
          action="/search"
          method="GET"
        )
          .header-search__inner
            input.header-search__input(
              type="text"
              placeholder="Nhập từ khóa..."
              name="keyword"
              value=keyword
              aria-label="Tìm kiếm"
            )
            button.header-search__btn(type="submit")
              i.bi.bi-search(aria-hidden="true")
              span Tìm

      .col-4
        .inner-menu
          ul.inner-menu__list
            li.inner-menu__item
              a.inner-menu__link(href="/") Trang chủ
            li.inner-menu__item.sub-menu
              -const pathProduct = "/products";
              a.inner-menu__link.sub-menu__trigger(href=pathProduct)
                | Sản phẩm
                i.bi.bi-chevron-down.sub-menu__caret(aria-hidden="true")
              +sub-menu(layoutProductsCategory, pathProduct)
            li.inner-menu__item
              a.inner-menu__link(href="/cart")
                i.bi.bi-cart3.mr-1(aria-hidden="true")
                | (#{miniCart ? miniCart.totalQuantity : "0"})
            if(user)
              li.inner-menu__item
                a.inner-menu__link(href="/user/info") #{user.fullName}
              li.inner-menu__item
                a.inner-menu__link(href="/orders")
                  i.bi.bi-box-seam.mr-1(aria-hidden="true")
                  | Đơn hàng
              li.inner-menu__item
                a.inner-menu__link.inner-menu__link--muted(href="/user/logout") Đăng xuất
            else
              li.inner-menu__item
                a.inner-menu__link(href="/user/login") Đăng nhập
              li.inner-menu__item
                a.inner-menu__link(href="/user/register") Đăng ký