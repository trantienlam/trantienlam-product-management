mixin product-item(item)
  .col-6.col-md-6.col-xl-3.mb-4
    article.product-item
      a.product-item__image-link(href=`/products/detail/${item.slug}`)
        .inner-image
          img(src=item.thumbnail, alt=item.title, loading="lazy")
          .product-item__image-overlay
          if(item.featured == "1")
            .inner-featured
              i.bi.bi-star-fill
              | Nổi bật
          if(item.discountPercentage > 0)
            .inner-discount-tag -#{item.discountPercentage}%
          if(item.soldCount > 0)
            .inner-sold-badge
              i.bi.bi-lightning-fill
              | Đã bán #{item.soldCount}
          .product-item__hover
            i.bi.bi-eye
            | Xem chi tiết
      .product-item__content
        .product-item__top
          .product-item__eyebrow
            if(item.category && item.category.title)
              span.product-item__category
                i.bi.bi-tag
                | #{item.category.title}
            if(item.featured == "1")
              span.product-item__badge
                i.bi.bi-patch-check-fill
                | Gợi ý hot
          h3.product-item__title
            a(href=`/products/detail/${item.slug}`) #{item.title}
        .product-item__bottom
          .product-item__price-wrap
            .product-item__prices
              if(item.priceNew)
                span.product-item__price-new #{item.priceNew.toLocaleString("vi-VN")}đ
              if(item.price && item.priceNew && item.price !== item.priceNew)
                span.product-item__price-old #{item.price.toLocaleString("vi-VN")}đ
            if(item.discountPercentage > 0)
              span.product-item__save Tiết kiệm #{item.discountPercentage}%
          a.product-item__action(href=`/products/detail/${item.slug}`)
            i.bi.bi-bag-plus
            | Xem sản phẩm
