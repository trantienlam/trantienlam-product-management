extends ../../layouts/default.pug 
block main
  .container.mt-5
    h2 Thanh toán VNPAY

    form(method="POST", action="/payment/create")
      .mb-3
        label.form-label Số tiền (VND)
        input.form-control(type="number", name="amount", value="10000", required)

      .mb-3
        label.form-label Ngân hàng
        select.form-select(name="bankCode")
          option(value="") -- Chọn ngân hàng --
          option(value="NCB") NCB
          option(value="VCB") Vietcombank

      button.btn.btn-primary(type="submit") Thanh toán