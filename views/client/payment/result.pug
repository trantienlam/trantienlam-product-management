extends ../layouts/default.pug

block styles
  link(rel="preconnect" href="https://fonts.googleapis.com")
  link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
  link(href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet")
  link(rel="stylesheet", href="/css/payment-result.css")

block main
  - const txnRef = data && data.vnp_TxnRef ? data.vnp_TxnRef.toString().slice(-8).toUpperCase() : 'N/A'
  - const rspCode = data && data.vnp_ResponseCode ? data.vnp_ResponseCode : ''

  .payment-result
    section.payment-result__banner
      .payment-result__banner-bg
      .payment-result__banner-inner
        .payment-result__icon
          i.bi.bi-x-lg
        h1.payment-result__title Thanh toán thất bại
        p.payment-result__subtitle Giao dịch VNPAY chưa hoàn tất. Bạn có thể thử lại hoặc chọn phương thức thanh toán khác.

    .payment-result__layout
      .pr-card
        .pr-card__head
          i.bi.bi-exclamation-triangle
          h4 Thông tin giao dịch
        .pr-card__body
          .pr-info-row
            span Mã đơn hàng
            span ##{txnRef}
          .pr-info-row.pr-info-row--danger
            span Mã phản hồi
            span= rspCode || '—'
          .pr-info-row
            span Lý do
            span
              case rspCode
                when "05"
                  | Bạn đã hủy giao dịch
                when "09"
                  | Tài khoản không đủ tiền
                when "11"
                  | Hết thời gian thanh toán
                when "24"
                  | Chưa đăng ký Internet Banking
                when "51"
                  | Không đủ số dư
                when "75"
                  | Ngân hàng đang bảo trì
                when "99"
                  | Lỗi không xác định
                default
                  | Vui lòng thử lại hoặc liên hệ hỗ trợ

      .pr-card
        .pr-card__head
          i.bi.bi-headset
          h4 Cần hỗ trợ?
        .pr-card__body
          p.pr-help Nếu tiền đã bị trừ nhưng đơn báo thất bại, vui lòng liên hệ ngay để được xử lý.
          ul.pr-contact
            li
              i.bi.bi-telephone
              span Hotline: 1900 xxxx
            li
              i.bi.bi-envelope
              span Email: support@example.com

      .pr-actions
        a.pr-btn.pr-btn--primary(href="/checkout")
          i.bi.bi-arrow-repeat
          | Thử lại thanh toán
        a.pr-btn.pr-btn--outline(href="/cart")
          i.bi.bi-cart3
          | Về giỏ hàng
        a.pr-btn.pr-btn--outline(href="/")
          i.bi.bi-house
          | Trang chủ
