extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  
  .container.my-3
    .row
      .col-12
        +box-head("Đặt hàng")

    // ===== GIỎ HÀNG =====
    .row
      .col-12
        table.table.table-bordered
          thead
            tr
              th STT
              th Ảnh
              th Tên
              th Giá
              th Số lượng
              th Tổng tiền
          tbody
            if(cartDetail.products.length > 0)
              each item, index in cartDetail.products
                tr
                  td #{index + 1}
                  td
                    img(
                      src=item.productInfo.thumbnail,
                      width="80"
                    )
                  td #{item.productInfo.title}
                  td #{item.productInfo.priceNew.toLocaleString()} đ
                  td #{item.quantity}
                  td #{item.totalPrice.toLocaleString()} đ
                  
            else
              tr
                td(colspan="6" class="text-center") Giỏ hàng trống

        if(cartDetail.products.length > 0)
          h4.text-end Tổng đơn hàng: #{cartDetail.totalPriceCartFormat.toLocaleString()} đ

    // ===== FORM =====
    if(cartDetail.products.length > 0)
      .row
        .col-12
          .card.p-4.my-4
            form(action="/checkout/order" method="POST")

              .mb-3
                label.form-label Họ tên
                input.form-control(
                  type="text",
                  name="fullName",
                  required
                )

              .mb-3
                label.form-label Số điện thoại
                input.form-control(
                  type="text",
                  name="phone",
                  required
                )

              .mb-3
                label.form-label Địa chỉ
                input.form-control(
                  type="text",
                  name="address",
                  required
                )

              // 🔥 THÊM THANH TOÁN
              .mb-3
                label.form-label Phương thức thanh toán
                select.form-select(name="paymentMethod")
                  option(value="cod") Thanh toán khi nhận hàng (COD)
                  option(value="vnpay") Thanh toán VNPAY

              button.btn.btn-success.w-100(type="submit")
                | ĐẶT HÀNG