extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  .checkout-page
    .container.py-4

      if isBuyNow
        .alert.alert-info.border-info.mb-4(role="alert")
          i.fa-solid.fa-bolt.me-2
          strong Mua ngay:
          |  chỉ thanh toán sản phẩm bên dưới. Giỏ hàng của bạn không bị thay đổi.
      else if selectedProducts && selectedProducts.length > 0
        .alert.alert-info.border-info.mb-4(role="alert")
          i.fa-solid.fa-circle-check.me-2
          | Bạn đang thanh toán các sản phẩm đã chọn từ giỏ hàng.

      //- ===== Step Indicator =====
      .checkout-steps.mb-5
        .step-indicator
          .step-item.completed
            .step-circle
              i.fa-solid.fa-cart-shopping
            .step-label Giỏ hàng
          .step-line.active
          .step-item.active
            .step-circle
              i.fa-solid.fa-pen-to-square
            .step-label Thông tin
          .step-line
          .step-item
            .step-circle
              i.fa-solid.fa-check
            .step-label Hoàn thành

      if cartDetail.products.length > 0
        //- ===== 2-Column Layout =====
        .checkout-layout
          //- LEFT: Cart Summary
          .checkout-left
            .checkout-card.mb-4
              .checkout-card-header
                i.fa-solid.fa-basket-shopping.me-2
                | Sản phẩm đã chọn
                span.badge-count #{cartDetail.products.length}
              .checkout-card-body.p-0
                .cart-items-list
                  each item in cartDetail.products
                    .cart-item-row
                      .cart-item-thumb
                        img(src=item.productInfo.thumbnail, alt=item.productInfo.title)
                      .cart-item-info
                        .cart-item-name #{item.productInfo.title}
                        .cart-item-meta
                          span.cart-item-price #{item.productInfo.priceNew.toLocaleString('vi-VN')} đ
                          span.cart-item-qty × #{item.quantity}
                      .cart-item-total #{item.totalPrice.toLocaleString('vi-VN')} đ

                .cart-summary-bar
                  .cart-summary-row.total
                    span Tổng tiền:
                    span.text-danger.fw-bold #{cartDetail.totalPriceCartFormat.toLocaleString('vi-VN')} đ
                  #voucherDiscountRow.cart-summary-row.discount(style="display:none")
                    span Giảm giá:
                    span.text-success.fw-bold -0 đ
                  #finalTotalRow.cart-summary-row.final-total(style="display:none")
                    span Thành tiền:
                    span.text-danger.fw-bold 0 đ

          //- RIGHT: Order Form
          .checkout-right
            .checkout-card
              .checkout-card-header
                i.fa-solid.fa-user-pen.me-2
                | Thông tin người nhận

              .checkout-card-body
                form(action="/checkout/order" method="POST" id="checkoutForm")
                  if selectedProducts && selectedProducts.length > 0
                    each selectedProductId in selectedProducts
                      input(type="hidden" name="selectedProducts" value=selectedProductId)

                  //- Full Name
                  .form-group-custom.mb-3
                    label.form-label-custom
                      i.fa-solid.fa-user.me-2
                      | Họ và tên
                    input.form-control-custom(
                      type="text",
                      name="fullName",
                      placeholder="Nhập họ và tên của bạn",
                      value=formData && formData.fullName ? formData.fullName : "",
                      required
                    )

                  //- Phone
                  .form-group-custom.mb-3
                    label.form-label-custom
                      i.fa-solid.fa-phone.me-2
                      | Số điện thoại
                    input.form-control-custom(
                      type="text",
                      name="phone",
                      placeholder="0xxx xxx xxx",
                      value=formData && formData.phone ? formData.phone : "",
                      required
                    )
                    small#phoneValidationMessage.text-danger.mt-1.d-none
                      i.fa-solid.fa-circle-exclamation.me-1
                      | Số điện thoại phải gồm đúng 10 số và bắt đầu bằng 0.

                  //- Address
                  .form-group-custom.mb-3
                    label.form-label-custom
                      i.fa-solid.fa-location-dot.me-2
                      | Địa chỉ nhận hàng
                    input.form-control-custom(
                      type="text",
                      name="address",
                      placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành",
                      value=formData && formData.address ? formData.address : "",
                      required
                    )

                  //- Voucher Section
                  .voucher-section.mb-4
                    .voucher-input-group
                      .input-group
                        input#voucherCode.form-control-custom(
                          type="text",
                          name="voucherCode",
                          placeholder="Nhập mã voucher (nếu có)"
                          autocomplete="off"
                        )
                        button#applyVoucherBtn.btn-voucher-apply(type="button")
                          i.fa-solid.fa-tags.me-1
                          | Áp dụng
                      .voucher-error.text-danger.small.mt-1(style="display:none")
                      .voucher-success.text-success.small.mt-1(style="display:none")

                    //- Applied Voucher Info
                    #appliedVoucherArea.voucher-applied.mt-2(style="display:none")
                      .voucher-applied-card
                        .voucher-applied-info
                          i.fa-solid.fa-ticket-simple.me-2
                          span#appliedVoucherName
                          span.badge-voucher-type.ms-2
                        button#removeVoucherBtn.btn-remove-voucher(type="button" title="Xóa voucher")
                          i.fa-solid.fa-xmark

                    //- Hidden input for voucher discount
                    input#voucherDiscount(type="hidden" name="voucherDiscount" value="0")
                    input#voucherCodeHidden(type="hidden" name="voucherCodeHidden" value="")

                  //- Payment Method
                  .form-group-custom.mb-4
                    label.form-label-custom
                      i.fa-solid.fa-credit-card.me-2
                      | Phương thức thanh toán
                    .payment-options
                      label.payment-option.active(for="cod")
                        input#cod(type="radio" name="paymentMethod" value="cod" checked)
                        .payment-card
                          .payment-icon
                            i.fa-solid.fa-money-bill-wave
                          .payment-info
                            .payment-name Thanh toán khi nhận hàng
                            .payment-desc Giao hàng → Nhận → Trả tiền
                          .payment-check
                            i.fa-solid.fa-circle-check
                      label.payment-option(for="vnpay")
                        input#vnpay(type="radio" name="paymentMethod" value="vnpay")
                        .payment-card
                          .payment-icon
                            i.fa-solid.fa-qrcode
                          .payment-info
                            .payment-name Thanh toán VNPAY
                            .payment-desc Thanh toán trực tuyến qua QR
                          .payment-check
                            i.fa-solid.fa-circle-check

                  //- Submit Button
                  button.btn-checkout-submit(type="submit")
                    i.fa-solid.fa-bag-shopping.me-2
                    | Xác nhận đặt hàng

        //- ===== Security Note =====
        .checkout-security-note.text-center.mt-4
          i.fa-solid.fa-shield-halved.me-2
          | Thông tin của bạn được bảo mật an toàn. Giao hàng trong 2-5 ngày làm việc.

      else
        //- Empty Cart
        .checkout-empty.text-center.py-5
          .checkout-empty-icon.mb-3
            i.fa-solid.fa-cart-shopping
          h3 Giỏ hàng trống
          p.text-muted.mb-4 Bạn chưa có sản phẩm nào trong giỏ hàng.
          a.btn.btn-primary.btn-lg(href="/products")
            i.fa-solid.fa-bag-shopping.me-2
            | Tiếp tục mua sắm

append scripts
  script.
    window.checkoutCartTotal = !{JSON.stringify(cartDetail.totalPriceCart)};
  script(src="/js/checkout-page.js")
