extends ../../layouts/default.pug

block styles
  link(rel="preconnect" href="https://fonts.googleapis.com")
  link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
  link(href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet")
  link(rel="stylesheet", href="/css/checkout-success.css")

block main
  - const orderCode = order._id.toString().slice(-8).toUpperCase()
  - const payFinal = typeof finalAmount !== 'undefined' ? finalAmount : ((order.amount || 0) - (order.discountAmount || 0))

  .checkout-success
    canvas#confetti-canvas

    section.checkout-success__banner(class=isVnpay ? 'checkout-success__banner--vnpay' : '')
      .checkout-success__banner-bg
      .checkout-success__banner-mesh
      .checkout-success__banner-glow.checkout-success__banner-glow--1
      .container.checkout-success__banner-inner
        .checkout-success__icon-wrap
          .checkout-success__ring
          .checkout-success__ring.checkout-success__ring--2
          .checkout-success__icon
            if isVnpay
              i.bi.bi-credit-card-2-front
            else
              i.bi.bi-bag-check

        if isVnpay
          h1.checkout-success__title Thanh toán thành công!
          p.checkout-success__subtitle Đơn hàng đã được thanh toán qua VNPAY. Chúng tôi sẽ xử lý và giao hàng sớm nhất.
        else
          h1.checkout-success__title Đặt hàng thành công!
          p.checkout-success__subtitle Cảm ơn bạn đã tin tưởng. Đơn hàng đang được xác nhận — bạn thanh toán khi nhận hàng.

        .checkout-success__order-pill
          i.bi.bi-receipt
          span Mã đơn:
          strong ##{orderCode}

        .checkout-success__badges
          if isVnpay
            span.checkout-success__badge.checkout-success__badge--method-vnpay
              i.bi.bi-wallet2
              | VNPAY
            span.checkout-success__badge.checkout-success__badge--paid
              i.bi.bi-check-circle-fill
              | Đã thanh toán
          else if isCod
            span.checkout-success__badge.checkout-success__badge--method-cod
              i.bi.bi-cash-coin
              | COD
            span.checkout-success__badge.checkout-success__badge--pending
              i.bi.bi-clock
              | Thanh toán khi nhận

    .container.checkout-success__layout
      .checkout-success__main
        //- Timeline
        .cs-card
          .cs-card__head
            .cs-card__head-left
              .cs-card__head-icon.cs-card__head-icon--green
                i.bi.bi-truck
              div
                h4 Tình trạng đơn hàng
                p Đơn hàng đang được xử lý
          .cs-card__body
            .cs-timeline
              .cs-timeline__step.is-done
                .cs-timeline__dot
                  i.bi.bi-check-lg
                span.cs-timeline__label Đặt hàng
                span.cs-timeline__time= moment(order.createdAt).format('HH:mm, DD/MM/YYYY')
              .cs-timeline__step.is-active
                .cs-timeline__dot
                  i.bi.bi-hourglass-split
                span.cs-timeline__label Xác nhận
                span.cs-timeline__time Vài phút tới
              .cs-timeline__step.is-pending
                .cs-timeline__dot
                  i.bi.bi-box-seam
                span.cs-timeline__label Giao hàng
                span.cs-timeline__time 2–5 ngày
              .cs-timeline__step.is-pending
                .cs-timeline__dot
                  i.bi.bi-house-check
                span.cs-timeline__label Hoàn tất
                span.cs-timeline__time Nhận hàng

        //- Products
        .cs-card
          .cs-card__head
            .cs-card__head-left
              .cs-card__head-icon
                i.bi.bi-cart3
              div
                h4 Chi tiết đơn hàng
                p Sản phẩm đã đặt
            span.cs-card__count #{order.products.length} SP
          .cs-card__body--flush
            each item in order.products
              .cs-product
                .cs-product__img
                  if item.productInfo && item.productInfo.thumbnail
                    img(src=item.productInfo.thumbnail alt=item.productInfo.title loading="lazy")
                  else
                    .cs-product__placeholder
                      i.bi.bi-image
                .cs-product__info
                  .cs-product__name= item.productInfo ? item.productInfo.title : 'Sản phẩm'
                  .cs-product__meta SL: #{item.quantity} × #{(item.priceNew || item.price || 0).toLocaleString('vi-VN')}đ
                .cs-product__price
                  .cs-product__total #{(item.totalPrice || 0).toLocaleString('vi-VN')}đ
            .cs-summary
              .cs-summary__row
                span Tạm tính
                span #{(order.amount || 0).toLocaleString('vi-VN')}đ
              if order.discountAmount && order.discountAmount > 0
                .cs-summary__row.cs-summary__row--discount
                  span
                    i.bi.bi-ticket-perforated.me-1
                    | Voucher #{order.voucher ? order.voucher.code : ''}
                  span -#{order.discountAmount.toLocaleString('vi-VN')}đ
              .cs-summary__row.cs-summary__row--total
                span Thành tiền
                span #{payFinal.toLocaleString('vi-VN')}đ

      aside.checkout-success__aside
        //- Payment
        .cs-card
          .cs-card__head
            .cs-card__head-left
              .cs-card__head-icon(class=isVnpay ? 'cs-card__head-icon--blue' : 'cs-card__head-icon--purple')
                i.bi(class=isVnpay ? 'bi-wallet2' : 'bi-cash-coin')
              div
                h4 Thanh toán
                p Phương thức
          .cs-card__body
            .cs-payment
              .cs-payment__icon(class=isVnpay ? 'cs-payment__icon--vnpay' : 'cs-payment__icon--cod')
                i.bi(class=isVnpay ? 'bi-credit-card-2-front' : 'bi-cash-stack')
              div
                if isVnpay
                  .cs-payment__name Thanh toán VNPAY
                  .cs-payment__desc Đã thanh toán #{payFinal.toLocaleString('vi-VN')}đ qua cổng VNPAY.
                else
                  .cs-payment__name Thanh toán khi nhận (COD)
                  .cs-payment__desc Thanh toán #{payFinal.toLocaleString('vi-VN')}đ trực tiếp cho shipper khi nhận hàng.
            if isVnpay && (order.vnpTransactionNo || order.vnpBankCode)
              .cs-payment__txn
                if order.vnpBankCode
                  | Ngân hàng
                  strong= order.vnpBankCode
                if order.vnpTransactionNo
                  | Mã giao dịch VNPAY
                  strong= order.vnpTransactionNo

        //- Delivery
        if order.userInfo
          .cs-card
            .cs-card__head
              .cs-card__head-left
                .cs-card__head-icon.cs-card__head-icon--green
                  i.bi.bi-geo-alt
                div
                  h4 Giao hàng
                  p Thông tin nhận
            .cs-card__body
              .cs-recipient
                .cs-recipient__avatar
                  i.bi.bi-person
                div
                  .cs-recipient__name= order.userInfo.fullName
                  .cs-recipient__phone= order.userInfo.phone
              .cs-recipient__addr
                i.bi.bi-pin-map
                span= order.userInfo.address

        //- Tips
        .cs-card
          .cs-card__head
            .cs-card__head-left
              .cs-card__head-icon
                i.bi.bi-lightbulb
              div
                h4 Lưu ý
                p Điều cần biết
          .cs-card__body
            ul.cs-tips
              li
                .cs-tips__icon
                  i.bi.bi-telephone
                div
                  .cs-tips__title Xác nhận qua điện thoại
                  .cs-tips__desc Chúng tôi gọi xác nhận trong vòng 24 giờ.
              li
                .cs-tips__icon
                  i.bi.bi-truck
                div
                  .cs-tips__title Giao hàng nhanh
                  .cs-tips__desc Dự kiến 2–5 ngày làm việc tùy khu vực.
              if isCod
                li
                  .cs-tips__icon
                    i.bi.bi-cash
                  div
                    .cs-tips__title Kiểm tra trước khi trả tiền
                    .cs-tips__desc Kiểm tra hàng trước khi thanh toán COD.

        .cs-actions
          a.cs-btn.cs-btn--primary(href="/orders")
            i.bi.bi-box-seam
            | Xem đơn hàng
          a.cs-btn.cs-btn--outline(href="/products")
            i.bi.bi-bag
            | Tiếp tục mua sắm
          a.cs-btn.cs-btn--ghost(href="/")
            i.bi.bi-house
            | Về trang chủ

    .container
      .cs-trust
        .cs-trust__left
          i.bi.bi-shield-check
          div
            h5 Mua sắm an toàn
            p Đổi trả 7 ngày · Thanh toán bảo mật · Hỗ trợ tận tâm
        a.cs-btn.cs-btn--primary(href="/products")
          i.bi.bi-arrow-right
          | Khám phá thêm

append scripts
  script(src="/js/checkout-confetti.js")
