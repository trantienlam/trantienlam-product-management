extends ../../layouts/default.pug

block main
  .checkout-success-page
    .container.py-5
      //- Success Header
      .success-header.text-center.mb-5
        .success-icon.mb-4
          .checkmark-circle
            .background
            .checkmark
        h1.success-title Đặt hàng thành công!
        p.success-subtitle Cảm ơn bạn đã mua sắm tại cửa hàng của chúng tôi

      //- Order Info Card
      .row.justify-content-center
        .col-lg-8
          .order-card.mb-4
            .order-card-header
              .d-flex.align-items-center
                i.fa-solid.fa-receipt.me-2
                h4.mb-0 Thông tin đơn hàng
              span.badge.bg-success.ms-auto #{order.paymentMethod === 'cod' ? 'COD' : 'Đã thanh toán'}

            .order-card-body
              .order-info-grid
                .info-item
                  .info-label Mã đơn hàng
                  .info-value.text-primary.fw-bold ##{order._id.toString().slice(-8).toUpperCase()}
                .info-item
                  .info-label Ngày đặt
                  .info-value #{moment(order.createdAt).format('DD/MM/YYYY HH:mm')}
                .info-item
                  .info-label Phương thức thanh toán
                  .info-value 
                    if order.paymentMethod === 'cod'
                      i.fa-solid.fa-money-bill-wave.me-1.text-success
                      | Thanh toán khi nhận hàng (COD)
                    else
                      i.fa-solid.fa-credit-card.me-1.text-success
                      | Thanh toán VNPAY
                .info-item
                  .info-label Trạng thái
                  .info-value
                    case order.status
                      when 'confirmed'
                        span.badge.bg-warning Đang xử lý
                      when 'completed'
                        span.badge.bg-success Hoàn thành
                      when 'pending'
                        span.badge.bg-info Chờ thanh toán
                      when 'failed'
                        span.badge.bg-danger Thanh toán thất bại
                      default
                        span.badge.bg-secondary #{order.status}

          //- Customer Info Card
          if order.userInfo
            .info-card.mb-4
              .info-card-header
                i.fa-solid.fa-user.me-2
                h4.mb-0 Thông tin người nhận
              .info-card-body
                .row
                  .col-md-4.mb-3
                    .info-label.small.text-muted Họ tên
                    .info-value.fw-medium #{order.userInfo.fullName}
                  .col-md-4.mb-3
                    .info-label.small.text-muted Số điện thoại
                    .info-value.fw-medium #{order.userInfo.phone}
                  .col-md-4.mb-3
                    .info-label.small.text-muted Địa chỉ
                    .info-value.fw-medium #{order.userInfo.address}

          //- Products Card
          .products-card.mb-4
            .products-card-header
              i.fa-solid.fa-box-open.me-2
              h4.mb-0 Sản phẩm đã đặt (#{order.products.length})
            .products-card-body.p-0
              table.table.table-hover.align-middle.mb-0
                thead
                  tr
                    th.px-4 Sản phẩm
                    th.text-center Số lượng
                    th.text-end.px-4 Đơn giá
                    th.text-end.px-4 Thành tiền
                tbody
                  each item in order.products
                    tr
                      td.px-4
                        .d-flex.align-items-center
                          if item.productInfo && item.productInfo.thumbnail
                            img(src=item.productInfo.thumbnail, alt=item.productInfo.title, width="50", height="50", class="rounded me-3 object-fit-cover")
                          .product-info
                            .product-name.fw-medium #{item.productInfo ? item.productInfo.title : 'Sản phẩm'}
                            .product-id.small.text-muted ID: #{item.product_id.toString().slice(-6).toUpperCase()}
                      td.text-center #{item.quantity}
                      td.text-end.px-4 #{item.priceNew ? item.priceNew.toLocaleString('vi-VN') : (item.price || 0).toLocaleString('vi-VN')} đ
                      td.text-end.px-4.fw-bold.text-primary #{item.totalPrice ? item.totalPrice.toLocaleString('vi-VN') : '0'} đ
                tfoot
                  tr.table-light
                    td(colspan="3", class="text-end fw-bold px-4") Tổng cộng:
                    td.text-end.px-4.fw-bold.fs-5.text-danger #{order.amount ? order.amount.toLocaleString('vi-VN') : '0'} đ

          //- Next Steps Card
          .next-steps-card.mb-4
            .next-steps-header
              i.fa-solid.fa-clipboard-list.me-2
              h4.mb-0 Các bước tiếp theo
            .next-steps-body
              .step-item
                .step-number 1
                .step-content
                  .step-title Xác nhận đơn hàng
                  .step-desc Chúng tôi sẽ liên hệ xác nhận đơn hàng qua điện thoại trong vòng 24 giờ
              .step-item
                .step-number 2
                .step-content
                  .step-title Giao hàng
                  .step-desc Đơn hàng sẽ được giao trong 2-5 ngày làm việc (tùy khu vực)
              .step-item
                .step-number 3
                .step-content
                  .step-title Nhận hàng & Thanh toán
                  .step-desc 
                    if order.paymentMethod === 'cod'
                      | Thanh toán bằng tiền mặt khi nhận được hàng
                    else
                      | Hàng đã được thanh toán trực tuyến qua VNPAY

          //- Action Buttons
          .action-buttons.text-center
            a.btn.btn-outline-primary.btn-lg.me-3(href="/")
              i.fa-solid.fa-house.me-2
              | Về trang chủ
            a.btn.btn-primary.btn-lg(href="/products")
              i.fa-solid.fa-bag-shopping.me-2
              | Tiếp tục mua sắm

append scripts
  script.
    :root {
      background: linear-gradient(135deg, \#f8f9fa 0%, \#e9ecef 100%);
      min-height: 100vh;
    }
    
    .success-icon {
      animation: scaleIn 0.5s ease-out;
    }
    
    .checkmark-circle {
      position: relative;
      width: 100px;
      height: 100px;
      margin: 0 auto;
    }
    
    .checkmark-circle .background {
      position: absolute;
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: linear-gradient(135deg, \#28a745, \#20c997);
      animation: bounceIn 0.6s ease-out;
    }
    
    .checkmark-circle .checkmark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 40px;
      height: 20px;
      border: 4px solid \#fff;
      border-top: none;
      border-right: none;
      transform: translate(-50%, -60%) rotate(-45deg);
      animation: drawCheck 0.4s ease-out 0.3s forwards;
    }
    
    @keyframes scaleIn {
      from { transform: scale(0); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    
    @keyframes bounceIn {
      0% { transform: scale(0); }
      50% { transform: scale(1.1); }
      70% { transform: scale(0.95); }
      100% { transform: scale(1); }
    }
    
    @keyframes drawCheck {
      0% { opacity: 0; }
      100% { opacity: 1; }
    }
    
    .success-title {
      font-size: 2rem;
      font-weight: 700;
      color: \#28a745;
      margin-bottom: 0.5rem;
    }
    
    .success-subtitle {
      font-size: 1.1rem;
      color: \#6c757d;
    }
    
    .order-card, .info-card, .products-card, .next-steps-card {
      background: \#fff;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      overflow: hidden;
      border: none;
    }
    
    .order-card-header, .info-card-header, .products-card-header, .next-steps-header {
      background: linear-gradient(135deg, \#667eea 0%, \#764ba2 100%);
      color: \#fff;
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: center;
    }
    
    .order-card-header h4, .info-card-header h4, .products-card-header h4, .next-steps-header h4 {
      font-weight: 600;
    }
    
    .order-card-body {
      padding: 1.5rem;
    }
    
    .order-info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
    }
    
    .info-label {
      color: \#6c757d;
      font-size: 0.875rem;
      margin-bottom: 0.25rem;
    }
    
    .info-value {
      font-size: 1rem;
      color: \#212529;
    }
    
    .info-card-body {
      padding: 1.5rem;
    }
    
    .products-card-header {
      background: linear-gradient(135deg, \#f093fb 0%, \#f5576c 100%);
    }
    
    .products-card-body table thead tr {
      background: \#f8f9fa;
    }
    
    .products-card-body table th {
      font-weight: 600;
      color: \#495057;
      border: none;
      padding: 1rem;
    }
    
    .products-card-body table td {
      padding: 1rem;
      border-color: \#f1f1f1;
      vertical-align: middle;
    }
    
    .products-card-body table tfoot td {
      border-top: 2px solid \#dee2e6;
    }
    
    .product-name {
      color: \#212529;
    }
    
    .object-fit-cover {
      object-fit: cover;
    }
    
    .next-steps-card-header {
      background: linear-gradient(135deg, \#4facfe 0%, \#00f2fe 100%);
    }
    
    .next-steps-body {
      padding: 1.5rem;
    }
    
    .step-item {
      display: flex;
      align-items: flex-start;
      margin-bottom: 1.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px dashed \#dee2e6;
    }
    
    .step-item:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }
    
    .step-number {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, \#667eea 0%, \#764ba2 100%);
      color: \#fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.9rem;
      flex-shrink: 0;
      margin-right: 1rem;
    }
    
    .step-title {
      font-weight: 600;
      color: \#212529;
      margin-bottom: 0.25rem;
    }
    
    .step-desc {
      color: \#6c757d;
      font-size: 0.9rem;
      line-height: 1.5;
    }
    
    .action-buttons .btn {
      padding: 0.75rem 2rem;
      font-weight: 600;
      border-radius: 50px;
      transition: all 0.3s ease;
    }
    
    .action-buttons .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }
