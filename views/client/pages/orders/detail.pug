extends ../../layouts/default.pug

block main
  .order-detail-page
    .container.py-5
      //- Back Button & Header
      .page-header.mb-4
        a.btn.btn-outline-secondary.mb-3(href="/orders")
          i.fa-solid.fa-arrow-left.me-2
          | Quay lại danh sách đơn hàng
        .order-header
          .d-flex.align-items-center.justify-content-between.flex-wrap.gap-3
            div
              h1.page-title.mb-1 Chi tiết đơn hàng
              .order-id # #{order.orderCode}
            .order-status-badge
              - let statusText = '';
              case order.status
                when 'pending'
                  if order.paymentMethod === 'vnpay'
                    span.badge.badge-processing.fs-6 Đã xác nhận
                  else
                    span.badge.badge-pending.fs-6 Chờ xác nhận
                when 'processing'
                  span.badge.badge-processing.fs-6 Đang xử lý
                when 'shipping'
                  span.badge.badge-shipping.fs-6 Đang vận chuyển
                when 'delivered'
                  span.badge.badge-delivered.fs-6 Đã giao hàng
                when 'completed'
                  span.badge.badge-completed.fs-6 Hoàn thành
                when 'failed'
                  span.badge.badge-failed.fs-6 Thanh toán thất bại
                when 'cancelled'
                  span.badge.badge-cancelled.fs-6 Đã hủy
                default
                  span.badge.fs-6 #{order.status}

      //- Alert Messages
      if(success)
        .alert.alert-success.alert-dismissible.fade.show
          i.fa-solid.fa-check-circle.me-2
          | !{success}
          button.btn-close(type="button" data-bs-dismiss="alert")
      if(error)
        .alert.alert-danger.alert-dismissible.fade.show
          i.fa-solid.fa-exclamation-circle.me-2
          | !{error}
          button.btn-close(type="button" data-bs-dismiss="alert")

      .row
        .col-lg-8
          //- Order Timeline
          .card.mb-4
            .card-header
              i.fa-solid.fa-clock-rotate-left.me-2
              | Trạng thái đơn hàng
            .card-body
              .order-timeline
                //- Bước 1: Đặt hàng - luôn completed
                .timeline-item.timeline-item--completed
                  .timeline-marker
                    i.fa-solid.fa-check
                  .timeline-content
                    .timeline-title Đặt hàng thành công
                    .timeline-date #{moment(order.createdAt).format('DD/MM/YYYY HH:mm')}
                
                //- Bước 2: Xác nhận - VNPAY thì completed, COD thì theo status
                - let isConfirmed = order.paymentMethod === 'vnpay' || ['processing', 'shipping', 'delivered', 'completed'].includes(order.status);
                .timeline-item(class={completed: isConfirmed})
                  .timeline-marker
                    i.fa-solid.fa-check
                  .timeline-content
                    .timeline-title Xác nhận
                    .timeline-date
                      if order.paymentMethod === 'vnpay'
                        | Thanh toán thành công
                      else if isConfirmed
                        | Đã xác nhận
                      else
                        | Chờ xác nhận
                
                //- Bước 3: Xử lý
                .timeline-item(class={completed: ['processing', 'shipping', 'delivered', 'completed'].includes(order.status)})
                  .timeline-marker
                    i.fa-solid.fa-box
                  .timeline-content
                    .timeline-title Xử lý
                    .timeline-date
                      case order.status
                        when 'processing'
                          | Đang chuẩn bị hàng
                        when 'shipping'
                        when 'delivered'
                        when 'completed'
                          | Đã xử lý xong
                        default
                          if order.paymentMethod === 'cod'
                            | Chờ xác nhận
                          else
                            | Chờ xử lý
                
                //- Bước 4: Vận chuyển
                .timeline-item(class={completed: ['shipping', 'delivered', 'completed'].includes(order.status)})
                  .timeline-marker
                    i.fa-solid.fa-truck
                  .timeline-content
                    .timeline-title Vận chuyển
                    .timeline-date
                      case order.status
                        when 'shipping'
                          | Đang giao hàng
                        when 'delivered'
                        when 'completed'
                          | Đã giao hàng
                        default
                          | Chưa vận chuyển
                
                //- Bước 5: Hoàn thành
                .timeline-item(class={completed: order.status === 'completed'})
                  .timeline-marker
                    i.fa-solid.fa-star
                  .timeline-content
                    .timeline-title Hoàn thành
                    .timeline-date
                      if order.status === 'completed'
                        | Cảm ơn bạn đã mua sắm!

          //- Products List
          - var showReviewAction = ['delivered', 'completed'].includes(order.status)
          .card.mb-4
            .card-header
              i.fa-solid.fa-box-open.me-2
              | Sản phẩm (#{order.products.length})
            .card-body.p-0
              table.table.table-hover.align-middle.mb-0
                thead
                  tr
                    th.px-4 Sản phẩm
                    th.text-center Số lượng
                    th.text-end.px-4 Đơn giá
                    th.text-end.px-4 Thành tiền
                    if showReviewAction
                      th.text-center.px-3(style="white-space:nowrap") Đánh giá
                tbody
                  each item in order.products
                    tr
                      td.px-4
                        .d-flex.align-items-center
                          if item.productInfo && item.productInfo.thumbnail
                            img.product-thumb(
                              src=item.productInfo.thumbnail
                              alt=item.productInfo.title
                              width="60"
                              height="60"
                            )
                          else
                            img.product-thumb(
                              src="/images/no-image.png"
                              alt="No image"
                              width="60"
                              height="60"
                            )
                          .product-info.ms-3
                            .product-name.fw-medium #{item.productInfo ? item.productInfo.title : 'Sản phẩm'}
                            .product-id.small.text-muted ID: #{item.product_id.toString().slice(-6).toUpperCase()}
                      td.text-center #{item.quantity}
                      td.text-end.px-4
                        if item.originalPrice && item.originalPrice > item.priceNew
                          .original-price #{item.originalPrice.toLocaleString('vi-VN')} đ
                        .current-price #{item.priceNew.toLocaleString('vi-VN')} đ
                      td.text-end.px-4.fw-bold.text-primary #{item.totalPrice.toLocaleString('vi-VN')} đ
                      if showReviewAction
                        td.text-center.px-3.align-middle
                          if item.productInfo && item.productInfo.slug
                            if item.hasUserReviewed
                              //- Đã đánh giá -> Hiển thị nút "Mua lại"
                              a.btn.btn-sm.btn-outline-success(href=`/products/detail/${item.productInfo.slug}` title="Mua lại sản phẩm này")
                                i.fa-solid.fa-cart-shopping.me-1
                                | Mua lại
                            else
                              //- Chưa đánh giá -> Hiển thị nút "Đánh giá"
                              a.btn.btn-sm.btn-outline-primary(href=`/reviews/write/${item.product_id}?orderId=${order._id}` title="Đánh giá sản phẩm đã mua")
                                i.fa-solid.fa-star.me-1
                                | Đánh giá
                          else
                            span.text-muted.small —
                tfoot
                  tr.table-light
                    td(colspan="3", class="text-end fw-bold px-4 fs-5") Tổng cộng:
                    td.text-end.px-4.fw-bold.fs-5.text-danger #{order.amount.toLocaleString('vi-VN')} đ
                    if showReviewAction
                      td

          //- Product Reviews Section (CHỈ HIỂN THỊ KHI ĐƠN ĐÃ GIAO THÀNH CÔNG)
          if ['delivered', 'completed'].includes(order.status)
            .card.mb-4
              .card-header
                i.fa-solid.fa-star.me-2
                | Đánh giá sản phẩm
              .card-body
                each item in order.products
                  if item.productInfo && item.reviews && item.reviews.length > 0
                    .order-product-review.mb-4
                      .order-product-review__header
                        img.order-product-review__thumb(
                          src=item.productInfo.thumbnail || "/images/no-image.png"
                          alt=item.productInfo.title
                          width="50"
                          height="50"
                        )
                        a.order-product-review__name(href=`/products/detail/${item.productInfo.slug}`)
                          | #{item.productInfo.title}
                      .order-product-review__list
                        each review in item.reviews
                          .order-review-item
                            .order-review-item__avatar
                              if review.userAvatar
                                img.order-review-item__avatar-img(
                                  src=review.userAvatar
                                  alt=review.userName
                                  width="40"
                                  height="40"
                                  loading="lazy"
                                )
                              else
                                span.order-review-item__avatar-default= review.userName ? review.userName.charAt(0).toUpperCase() : "?"
                            .order-review-item__info
                              .order-review-item__name= review.userName || "Khách hàng"
                              .order-review-item__stars
                                - for(var i = 0; i < 5; i++)
                                  if(i < review.rating)
                                    i.fa-solid.fa-star.text-warning
                                  else
                                    i.fa-solid.fa-star.text-muted
                              .order-review-item__date
                                i.fa-regular.fa-clock.me-1
                                | #{moment(review.createdAt).format('DD/MM/YYYY HH:mm')}
                              if review.comment
                                .order-review-item__comment #{review.comment}
                              if review.images && review.images.length
                                .order-review-item__photos
                                  each photo in review.images
                                    a.order-review-item__photo-link(href=photo target="_blank" rel="noopener noreferrer")
                                      img.order-review-item__photo(src=photo alt="Ảnh đánh giá" loading="lazy")
                  else if item.productInfo
                    .order-product-review.mb-4
                      .order-product-review__header
                        img.order-product-review__thumb(
                          src=item.productInfo.thumbnail || "/images/no-image.png"
                          alt=item.productInfo.title
                          width="50"
                          height="50"
                        )
                        a.order-product-review__name(href=`/products/detail/${item.productInfo.slug}`)
                          | #{item.productInfo.title}
                      .order-product-review__empty
                        i.fa-solid.fa-chat-dots.me-2
                        | Chưa có đánh giá nào cho sản phẩm này.

        .col-lg-4
          //- Order Info Card
          .card.mb-4
            .card-header
              i.fa-solid.fa-info-circle.me-2
              | Thông tin đơn hàng
            .card-body
              .info-item.mb-3
                .info-label Mã đơn hàng
                .info-value.text-primary.fw-bold # #{order.orderCode}
              .info-item.mb-3
                .info-label Ngày đặt
                .info-value #{moment(order.createdAt).format('DD/MM/YYYY HH:mm')}
              .info-item.mb-3
                .info-label Phương thức thanh toán
                .info-value
                  if order.paymentMethod === 'cod'
                    i.fa-solid.fa-money-bill-wave.me-1.text-success
                    | Thanh toán khi nhận hàng (COD)
                  else
                    i.fa-solid.fa-credit-card.me-1.text-success
                    | Thanh toán VNPAY
              .info-item.mb-3
                .info-label Trạng thái thanh toán
                .info-value
                  case order.paymentStatus
                    when 'paid'
                      span.badge.bg-success Đã thanh toán
                    when 'unpaid'
                      span.badge.bg-warning.text-dark Chưa thanh toán
                    when 'failed'
                      span.badge.bg-danger Thanh toán thất bại
              if order.vnpTransactionNo
                .info-item
                  .info-label Mã giao dịch VNPAY
                  .info-value.small #{order.vnpTransactionNo}

          //- Recipient Info Card
          if order.userInfo
            .card.mb-4
              .card-header
                i.fa-solid.fa-user.me-2
                | Thông tin người nhận
              .card-body
                .recipient-info
                  .recipient-item.mb-3
                    .recipient-label Họ tên
                    .recipient-value.fw-medium #{order.userInfo.fullName}
                  .recipient-item.mb-3
                    .recipient-label Số điện thoại
                    .recipient-value
                      a.text-primary(href=`tel:${order.userInfo.phone}`)
                        | #{order.userInfo.phone}
                  .recipient-item
                    .recipient-label Địa chỉ
                    .recipient-value #{order.userInfo.address}

          //- Action Buttons
          if order.status === 'pending' || order.status === 'processing'
            .card.mb-4.border-danger
              .card-header.bg-danger.text-white
                i.fa-solid.fa-exclamation-circle.me-2
                | Hủy đơn hàng
              .card-body
                p.text-muted.small.mb-3
                  | Bạn có thể hủy đơn hàng nếu chưa được xử lý.
                a.btn.btn-danger.w-100(
                  href=`/orders/cancel/${order._id}`
                  onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');"
                )
                  i.fa-solid.fa-circle-xmark.me-2
                  | Hủy đơn hàng

append scripts
