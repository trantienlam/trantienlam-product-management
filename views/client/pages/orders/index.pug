extends ../../layouts/default.pug

block main
  .orders-page
    .container.py-5
      //- Page Header
      .page-header.mb-5
        .d-flex.align-items-center.justify-content-between
          div
            h1.page-title.mb-1 Đơn hàng của tôi
            p.page-subtitle.text-muted Theo dõi và quản lý các đơn hàng của bạn
          a.btn.btn-outline-primary(href="/")
            i.fa-solid.fa-house.me-2
            | Về trang chủ

      //- Status Filter
      .filter-section.mb-4
        .filter-tabs
          each item in filterStatus
            a.filter-tab(
              href=`/orders?status=${item.status}`
              class=item.class
            )
              | !{item.name}

      //- Orders List
      if(orders.length > 0)
        .orders-list
          each order in orders
            .order-card.mb-4
              .order-card-header
                .row.align-items-center.w-100
                  .col-md-4
                    .order-id
                      span.label Mã đơn hàng
                      span.value # #{order.orderCode}
                  .col-md-4
                    .order-date
                      span.label Ngày đặt
                      span.value #{moment(order.createdAt).format('DD/MM/YYYY HH:mm')}
                  .col-md-4.text-md-end
                    .order-status
                      case order.status
                        when 'pending'
                          span.badge.badge-pending Chờ xác nhận
                        when 'processing'
                          span.badge.badge-processing Đang xử lý
                        when 'shipping'
                          span.badge.badge-shipping Đang vận chuyển
                        when 'delivered'
                          span.badge.badge-delivered Đã giao hàng
                        when 'completed'
                          span.badge.badge-completed Hoàn thành
                        when 'failed'
                          span.badge.badge-failed Thanh toán thất bại
                        when 'cancelled'
                          span.badge.badge-cancelled Đã hủy
                        default
                          span.badge #{order.status}

              .order-card-body
                .row
                  //- Products Preview
                  .col-lg-8
                    .products-preview
                      .d-flex.gap-3.flex-wrap
                        each product, index in order.productsPreview
                          if(index < 3)
                            img.product-thumb(
                              src=product.thumbnail || "/images/no-image.png"
                              alt=product.title
                            )
                        if(order.products.length > 3)
                          .more-products-badge
                            | +#{order.products.length - 3}
                    .products-info.mt-3
                      p.products-count #{order.products.length} sản phẩm
                      a.btn.btn-sm.btn-link.text-primary(href=`/orders/detail/${order._id}`)
                        | Xem chi tiết
                        i.fa-solid.fa-arrow-right.ms-1

                  //- Order Summary
                  .col-lg-4
                    .order-summary.text-lg-end
                      .payment-method
                        if order.paymentMethod === 'cod'
                          i.fa-solid.fa-money-bill-wave.me-1.text-success
                          | Thanh toán khi nhận hàng
                        else
                          i.fa-solid.fa-credit-card.me-1.text-success
                          | Thanh toán VNPAY
                      .total-amount.mt-2
                        span.label Tổng tiền:
                        span.value #{order.amount.toLocaleString('vi-VN')} đ
                      if(order.paymentStatus === 'paid')
                        .payment-status.mt-1
                          span.badge.bg-success Đã thanh toán
                      else if(order.paymentStatus === 'unpaid' && order.paymentMethod === 'cod')
                        .payment-status.mt-1
                          span.badge.bg-warning Chưa thanh toán

      else
        //- Empty State
        .empty-state.text-center.py-5
          .empty-icon.mb-4
            i.fa-solid.fa-box-open
          h3.empty-title Chưa có đơn hàng nào
          p.empty-desc Bạn chưa có đơn hàng nào. Hãy bắt đầu mua sắm ngay!
          a.btn.btn-primary.btn-lg(href="/products")
            i.fa-solid.fa-bag-shopping.me-2
            | Bắt đầu mua sắm

      //- Pagination
      if(pagination.totalPage > 1)
        .pagination-wrapper.mt-5
          nav(aria-label="Orders pagination")
            ul.pagination.justify-content-center
              if(pagination.currentPage > 1)
                li.page-item
                  a.page-link(
                    href=`/orders?page=${pagination.currentPage - 1}`
                    aria-label="Previous"
                  )
                    i.fa-solid.fa-chevron-left
              - for(let i = 1; i <= pagination.totalPage; i++)
                li.page-item(class={active: pagination.currentPage === i})
                  a.page-link(href=`/orders?page=${i}`)
                    | #{i}
              if(pagination.currentPage < pagination.totalPage)
                li.page-item
                  a.page-link(
                    href=`/orders?page=${pagination.currentPage + 1}`
                    aria-label="Next"
                  )
                    i.fa-solid.fa-chevron-right

append scripts
  script(src="/js/orders-page.js")
