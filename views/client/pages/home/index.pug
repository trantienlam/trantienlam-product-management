extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/product-layout.pug
block main

  //- Hero: slider ảnh nền, tự đổi mỗi 5s (ảnh có thể đổi trong .hero-slide)
  .hero-banner#clientHeroBanner
    .hero-slides(aria-hidden="true")
      .hero-slide.is-active(style="background-image: url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1920&q=80');")
      .hero-slide(style="background-image: url('https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=1920&q=80');")
      .hero-slide(style="background-image: url('https://images.unsplash.com/photo-1607082349566-187342175e2f?w=1920&q=80');")
      .hero-slide(style="background-image: url('https://images.unsplash.com/photo-1472851294608-062f824d29cc?w=1920&q=80');")
    .hero-overlay
    .container.hero-inner
      .hero-content
        .hero-text
          h1.hero-title Chào mừng đến với cửa hàng của chúng tôi
          p.hero-subtitle Khám phá hàng ngàn sản phẩm chất lượng với giá tốt nhất
          .hero-buttons
            a.hero-btn.hero-btn-primary(href="#products-all") Khám phá ngay
            a.hero-btn.hero-btn-outline(href="#products-new") Sản phẩm mới
    .hero-dots(role="tablist" aria-label="Chọn ảnh banner")
      button.hero-dot.is-active(type="button" data-index="0" aria-label="Ảnh 1")
      button.hero-dot(type="button" data-index="1" aria-label="Ảnh 2")
      button.hero-dot(type="button" data-index="2" aria-label="Ảnh 3")
      button.hero-dot(type="button" data-index="3" aria-label="Ảnh 4")

  //- Sản phẩm nổi bật
  .section-products-featured.my-5
    .container
      .section-header-wrapper
        +box-head("Sản phẩm nổi bật")
        .section-nav
          a.section-nav-btn(href="#")
            i.bi.bi-chevron-left
          a.section-nav-btn(href="#")
            i.bi.bi-chevron-right

      if(productsFeatured && productsFeatured.length > 0)
        +product-grid(productsFeatured)
      else
        .text-center.text-muted.py-5
          i.bi.bi-inbox(style="font-size: 48px;")
          p.mt-2 Chưa có sản phẩm nào

  //- Sản phẩm mới (anchor cho nút hero "Sản phẩm mới")
  .section-products-new.my-5#products-new
    .container
      .section-header-wrapper
        +box-head("Sản phẩm mới")
        .section-badge-new Mới
        .section-nav
          a.section-nav-btn(href="#")
            i.bi.bi-chevron-left
          a.section-nav-btn(href="#")
            i.bi.bi-chevron-right

      if(productsNew && productsNew.length > 0)
        +product-grid(productsNew)
      else
        .text-center.text-muted.py-5
          i.bi.bi-inbox(style="font-size: 48px;")
          p.mt-2 Chưa có sản phẩm nào

  //- Tất cả sản phẩm
  .section-products-all.my-5#products-all
    .container
      .section-header-wrapper
        +box-head("Tất cả sản phẩm")
        .section-count
          i.bi.bi-collection
          | #{productsAll ? productsAll.length : 0} sản phẩm

      if(productsAll && productsAll.length > 0)
        +product-grid(productsAll)
      else
        .text-center.text-muted.py-5
          i.bi.bi-inbox(style="font-size: 48px;")
          p.mt-2 Chưa có sản phẩm nào

append scripts
  script(src="/js/home-hero.js")
