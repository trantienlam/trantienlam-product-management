extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)

  .auth-page
    .container
      .auth-card

        .auth-card__header
          .auth-card__logo
            i.bi.bi-shield-lock-fill
          h1.auth-card__title Quên mật khẩu
          p.auth-card__subtitle Nhập email để nhận liên kết đặt lại mật khẩu

        .auth-card__body
          form.auth-form(action="/user/password/forgot" method="POST")

            .form-group
              label.form-label(for="email") Địa chỉ email
              .auth-form__input-wrap
                i.bi.bi-envelope-fill.input-icon
                input#email.form-control(
                  type="email"
                  name="email"
                  placeholder="Nhập email đã đăng ký"
                  required
                  autocomplete="email"
                )

            button.auth-btn-primary(type="submit") Gửi yêu cầu

        .auth-card__footer
          | Nhớ mật khẩu?
          a(href="/user/login") Quay lại đăng nhập
