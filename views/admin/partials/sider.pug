.admin-sidebar
  .sidebar-header
    .sidebar-logo
      i.fa-solid.fa-shield-halved
      span Admin
  
  .sidebar-user
    a.sidebar-user-link(href=`${prefixAdmin}/accounts/detail/${user.id}`)
      .sidebar-user-avatar
        if user && user.avatar
          img(src=user.avatar alt=user.fullName)
        else
          .avatar-placeholder= user && user.fullName ? user.fullName.charAt(0).toUpperCase() : "A"
      span.sidebar-user-text= user && user.fullName ? user.fullName : "Admin"

  .sidebar-menu
    nav.sidebar-nav
      a.sidebar-link(href=`${prefixAdmin}/dashboard`)
        i.sidebar-icon.fa-solid.fa-chart-line
        span.sidebar-text Tổng quan
        
      if(role.permission.includes("products_view"))
        a.sidebar-link(href=`${prefixAdmin}/products`)
          i.sidebar-icon.fa-solid.fa-box-open
          span.sidebar-text Sản phẩm
          
      if(role.permission.includes("products-category_view"))  
        a.sidebar-link(href=`${prefixAdmin}/products-category`)
          i.sidebar-icon.fa-solid.fa-tags
          span.sidebar-text Danh mục
          
      if(role.permission.includes("orders_view"))
        a.sidebar-link(href=`${prefixAdmin}/orders`)
          i.sidebar-icon.fa-solid.fa-receipt
          span.sidebar-text Đơn hàng

      // Báo cáo - có submenu
      if(role.permission.includes("baocao_view"))
        .sidebar-dropdown
          a.sidebar-link(href=`${prefixAdmin}/reports`)
            i.sidebar-icon.fa-solid.fa-chart-column
            span.sidebar-text Báo cáo
            i.sidebar-arrow.fa-solid.fa-chevron-right
          .sidebar-dropdown-menu
            a.sidebar-dropdown-item(href=`${prefixAdmin}/reports`)
              i.fa-solid.fa-chart-line.me-2
              | Doanh thu
            a.sidebar-dropdown-item(href=`${prefixAdmin}/reports/products`)
              i.fa-solid.fa-box-open.me-2
              | Sản phẩm
            a.sidebar-dropdown-item(href=`${prefixAdmin}/reports/customers`)
              i.fa-solid.fa-users.me-2
              | Khách hàng
            a.sidebar-dropdown-item(href=`${prefixAdmin}/reports/inventory`)
              i.fa-solid.fa-warehouse.me-2
              | Tồn kho
          
      if(role.permission.includes("reviews_view"))
        a.sidebar-link(href=`${prefixAdmin}/reviews`)
          i.sidebar-icon.fa-solid.fa-star
          span.sidebar-text Đánh giá
          
      if(role.permission.includes("vouchers_view"))
        a.sidebar-link(href=`${prefixAdmin}/vouchers`)
          i.sidebar-icon.fa-solid.fa-ticket-simple
          span.sidebar-text Voucher
          
      if(role.permission.includes("chat_view"))
        a.sidebar-link(href=`${prefixAdmin}/chat`)
          i.sidebar-icon.fa-solid.fa-comments
          span.sidebar-text Chat Hỗ trợ

      if(role.permission.includes("accounts_view"))
        a.sidebar-link(href=`${prefixAdmin}/accounts`)
          i.sidebar-icon.fa-solid.fa-users
          span.sidebar-text Tài khoản
          
      if(role.permission.includes("roles_view"))
        a.sidebar-link(href=`${prefixAdmin}/roles`)
          i.sidebar-icon.fa-solid.fa-user-shield
          span.sidebar-text Nhóm quyền
          
      if(role.permission.includes("roles_permission"))
        a.sidebar-link(href=`${prefixAdmin}/roles/permissions`)
          i.sidebar-icon.fa-solid.fa-key
          span.sidebar-text Phân quyền
      if(role.permission.includes("caidat_view"))
        a.sidebar-link(href=`${prefixAdmin}/settings/general`)
          i.sidebar-icon.fa-solid.fa-gear
          span.sidebar-text Cài đặt

  .sidebar-footer
    a.sidebar-link.sidebar-link--logout(href=`${prefixAdmin}/auth/logout`)
      i.sidebar-icon.fa-solid.fa-right-from-bracket
      span.sidebar-text Đăng xuất