extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/select-tree.pug
block main
  if(role.permission.includes("products-category_edit"))
    +alert-error(5000)
    +alert-success(5000)
    h1(class="mb-4") Chỉnh sửa danh mục

    form(
      action = `${prefixAdmin}/products-category/edit/${product.id}?_method=PATCH`
      id = "form-edit-product"
      method="POST"
      enctype="multipart/form-data"
    )
      //- input(type="hidden" name="redirect" value=redirect)

      div(class="form-group")
        label(for ="title") Tiêu đề
        input(
          type="text"
          class="form-control"
          id="title"
          name="title"
          required
          value= product.title
        )


      div(class="form-group")
          label(for ="parent_id") Danh mục cha
          select(
            name="parent_id"
            id="parent_id"  
            class="form-control" 
          ) 
            option(value="") --Chọn danh mục cha--
            if(records)
              +select-tree(records, 1, product.parent_id)

      div(class="form-group")
        label(for ="desc") Mô tả
        textarea(
          class="form-control textarea-mce"
          id="desc"
          name="description"
          rows=5   
        ) #{product.description}

      
      div(
        class="form-group"
        upload-image
        )
        label(for ="thumbnail") Ảnh
        input(
          type="file"
          class="form-control-file"
          id="thumbnail"
          name="thumbnail"
          accept="image/*"
          upload-image-input
        )
        img(
          src=product.thumbnail
          upload-image-preview
          class= "image-preview"
        )
      div(class="form-group")
        label(for ="position") Vị trí
        input(
          type="number"
          class="form-control"
          id="position"
          name="position"
          placeholder="Tự động tăng"
          min="1"
          value= product.position
        )
      div(class="form-group form-check form-check-inline")
        input(
          type="radio"
          class="form-check-input"
          id="statusActive"
          name="status"
          value="active"
          checked=(product.status=="active" ? true : false )
        )
        label(for="statusActive" class="form-check-lable") Hoạt động
      div(class="form-group form-check form-check-inline")
        input(
          type="radio"
          class="form-check-input"
          id="statusInActive"
          name="status"
          value="inactive"
          checked=(product.status=="inactive" ? true : false )
        )
        lable(for="statusInActive" class="form-check-lable") Dừng hoạt động
      div(class="form-group")
        button(
          type="submit"
          class="btn btn-primary"
        ) Cập nhật
    script(src="/admin/js/script-category.js") 