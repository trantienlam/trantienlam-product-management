extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  if(role.permission.includes("vouchers_edit"))
    +alert-success(3000)
    +alert-error(3000)

    .voucher-form-page
      .container-fluid.py-4
        //- Page Header
        .page-header.d-flex.align-items-center.mb-4
          a.btn.btn-outline-secondary.me-3(href="/admin/vouchers")
            i.fa-solid.fa-arrow-left
          div
            h1.page-title.mb-1 Chỉnh sửa Voucher
            p.page-subtitle.text-muted Cập nhật thông tin voucher

        //- Form Card
        .card
          .card-body.p-4
            form(method="POST" action=`/admin/vouchers/edit/${voucher._id}`)
              .row.g-4
                //- Mã voucher (readonly)
                .col-md-6
                  label.form-label Mã voucher
                  input.form-control(
                    type="text"
                    value=voucher.code
                    readonly
                    disabled
                  )
                  .form-text Mã voucher không thể thay đổi

                //- Tên voucher
                .col-md-6
                  label.form-label
                    | Tên voucher 
                    span.text-danger *
                  input.form-control(
                    type="text"
                    name="name"
                    required
                    maxlength="100"
                    value=voucher.name
                  )

                //- Mô tả
                .col-12
                  label.form-label Mô tả
                  textarea.form-control(
                    name="description"
                    rows="2"
                  ) #{voucher.description}

                //- Loại giảm giá
                .col-md-4
                  label.form-label
                    | Loại giảm giá 
                    span.text-danger *
                  select.form-select(name="type" required)
                    option(value="percent" selected=voucher.type === 'percent') Giảm theo phần trăm (%)
                    option(value="fixed" selected=voucher.type === 'fixed') Giảm số tiền cố định (đ)

                //- Giá trị giảm
                .col-md-4
                  label.form-label
                    | Giá trị giảm 
                    span.text-danger *
                  .input-group
                    input.form-control(
                      type="number"
                      name="value"
                      required
                      min="1"
                      value=voucher.value
                      id="voucherValue"
                    )
                    span.input-group-text#valueSuffix #{voucher.type === 'percent' ? '%' : 'đ'}

                //- Giảm giá tối đa
                .col-md-4
                  label.form-label Giảm giá tối đa
                  .input-group
                    input.form-control(
                      type="number"
                      name="maxDiscount"
                      min="0"
                      value=voucher.maxDiscount
                    )
                    span.input-group-text đ

                //- Đơn hàng tối thiểu
                .col-md-6
                  label.form-label Đơn hàng tối thiểu
                  .input-group
                    input.form-control(
                      type="number"
                      name="minOrderValue"
                      min="0"
                      value=voucher.minOrderValue
                    )
                    span.input-group-text đ

                //- Số lượng
                .col-md-3
                  label.form-label
                    | Số lượng 
                    span.text-danger *
                  input.form-control(
                    type="number"
                    name="quantity"
                    required
                    min=voucher.usedCount
                    value=voucher.quantity
                  )
                  .form-text Đã dùng: #{voucher.usedCount}

                //- Giới hạn/user
                .col-md-3
                  label.form-label Giới hạn/user
                  input.form-control(
                    type="number"
                    name="perUserLimit"
                    min="1"
                    value=voucher.perUserLimit
                  )

                //- Ngày bắt đầu
                .col-md-6
                  label.form-label
                    | Ngày bắt đầu 
                    span.text-danger *
                  input.form-control(
                    type="date"
                    name="startDate"
                    required
                    value=voucher.startDate.toISOString().split('T')[0]
                  )

                //- Ngày kết thúc
                .col-md-6
                  label.form-label
                    | Ngày kết thúc 
                    span.text-danger *
                  input.form-control(
                    type="date"
                    name="endDate"
                    required
                    value=voucher.endDate.toISOString().split('T')[0]
                  )

                //- Kích hoạt
                .col-12
                  .form-check
                    input#isActive.form-check-input(
                      type="checkbox"
                      name="isActive"
                      value="true"
                      checked=voucher.isActive
                    )
                    label.form-check-label(for="isActive")
                      | Kích hoạt voucher

              hr.my-4

              //- Actions
              .d-flex.gap-2
                button.btn.btn-primary(type="submit")
                  i.fa-solid.fa-floppy-disk.me-2
                  | Lưu thay đổi
                a.btn.btn-outline-secondary(href="/admin/vouchers")
                  | Hủy

append scripts
  script(src="/admin/js/voucher-form.js")
