extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)

  //- Page Header
  .page-header
    .container
      .page-header__content
        .page-header__left
          .page-header__icon
            i.fa-solid.fa-chart-pie
          .page-header__text
            h1 Trang Tổng quan
            p Chào mừng trở lại, #{user ? user.fullName : "Quản trị viên"}
        .page-header__right
          .page-header__date
            i.fa-solid.fa-calendar
            span#dashboard-date

  //- Main Content
  .container

    //- Stats Cards Row
    .stats-grid
      .stat-card.stat-card--revenue
        .stat-card__header
          .stat-card__icon
            i.fa-solid.fa-money-bill-wave
          .stat-card__trend(class=changes.revenue.isUp ? 'stat-card__trend--up' : 'stat-card__trend--down')
            i.fa-solid(class=changes.revenue.isUp ? 'fa-arrow-up' : 'fa-arrow-down')
            | #{changes.revenue.isUp ? '+' : ''}#{changes.revenue.value}%
        .stat-card__value= statistic.order.totalRevenue.toLocaleString('vi-VN')
        .stat-card__label Tổng doanh thu (VNĐ)

      .stat-card.stat-card--orders
        .stat-card__header
          .stat-card__icon
            i.fa-solid.fa-shopping-bag
          .stat-card__trend(class=changes.orders.isUp ? 'stat-card__trend--up' : 'stat-card__trend--down')
            i.fa-solid(class=changes.orders.isUp ? 'fa-arrow-up' : 'fa-arrow-down')
            | #{changes.orders.isUp ? '+' : ''}#{changes.orders.value}%
        .stat-card__value= statistic.order.total
        .stat-card__label Tổng đơn hàng

      .stat-card.stat-card--products
        .stat-card__header
          .stat-card__icon
            i.fa-solid.fa-box
          //- .stat-card__trend(class=changes.products.isUp ? 'stat-card__trend--up' : 'stat-card__trend--down')
            //- i.fa-solid(class=changes.products.isUp ? 'fa-arrow-up' : 'fa-arrow-down')
            //- | #{changes.products.isUp ? '+' : ''}#{changes.products.value}%
        .stat-card__value= statistic.product.total
        .stat-card__label Sản phẩm

      .stat-card.stat-card--users
        .stat-card__header
          .stat-card__icon
            i.fa-solid.fa-users
        .stat-card__value= statistic.user.total
        .stat-card__label Khách hàng

    //- Charts Row
    .charts-row
      //- Revenue & Orders Chart (2 lines)
      .chart-card
        .chart-card__header
          h3
            i.fa-solid.fa-chart-area.text-primary.me-2
            | Doanh thu & Số đơn hàng 7 ngày gần đây
        .chart-card__body
          canvas#revenueChart

      //- Orders by Status Pie Chart
      .chart-card
        .chart-card__header
          h3
            i.fa-solid.fa-chart-pie.text-success.me-2
            | Đơn hàng theo trạng thái
        .chart-card__body
          canvas#ordersStatusChart

      //- Payment Status Chart
      .chart-card
        .chart-card__header
          h3
            i.fa-solid.fa-credit-card.text-warning.me-2
            | Trạng thái thanh toán
        .chart-card__body
          canvas#paymentChart

    //- Top Products Section
    .top-products-section
      .top-products-section__header
        h3.top-products-section__title
          i.fa-solid.fa-trophy
          | Top Sản phẩm Bán chạy
        a.top-products-section__link(href=`${prefixAdmin}/products`)
          | Xem tất cả
          i.fa-solid.fa-arrow-right

      if topProducts && topProducts.length > 0
        .top-products-grid
          each product, index in topProducts
            .top-product-card
              a.top-product-card__link(href=`${prefixAdmin}/products/detail/${product.slug || product.product_id}`)
                .top-product-card__rank= index + 1
                .top-product-card__image
                  if product.thumbnail
                    img(src=product.thumbnail, alt=product.title)
                  else
                    i.fa-solid.fa-image
                .top-product-card__title= product.title
                .top-product-card__stats
                  .top-product-card__stat.top-product-card__stat--quantity
                    span.top-product-card__stat-label Đã bán
                    span.top-product-card__stat-value= product.totalQuantity
                  .top-product-card__stat.top-product-card__stat--revenue
                    span.top-product-card__stat-label Doanh thu
                    span.top-product-card__stat-value= product.totalRevenue.toLocaleString('vi-VN') + ' đ'
      else
        .empty-state
          .empty-state__icon
            i.fa-solid.fa-box-open
          .empty-state__title Chưa có sản phẩm bán chạy
          .empty-state__desc Danh sách sản phẩm bán chạy sẽ hiển thị khi có đơn hàng

append scripts
  //- Expose chartData globally before page script
  script.
    window.chartData = !{JSON.stringify(chartData)};
  script(src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js")
  script(src="/admin/js/dashboard-page.js")

  //- Mini Chat Widget
  .mini-chat-float-btn(onclick="toggleMiniChatPanel()")
    i.fa-solid.fa-comments
    .mini-chat-badge#miniChatCountBadge 0

  .mini-chat-notification#miniChatNotification
    .mini-chat-notification-inner
      i.fa-solid.fa-bell
      span.notification-guest-name

  .mini-chat-panel.mini-chat-hidden#miniChatPanel
    .mini-chat-header
      .mini-chat-header-info
        i.fa-solid.fa-headset
        span#miniChatHeaderTitle Phiên chat mới
      .mini-chat-header-actions
        button.btn-delete-session(onclick="deleteMiniChatSession()", title="Xóa đoạn chat")
          i.fa-solid.fa-trash
        button(onclick="closeMiniChat()")
          i.fa-solid.fa-times
    .mini-chat-body
      .mini-chat-session-list#miniChatSessionList
      .mini-chat-area#miniChatArea(style="display: none;")
        .mini-chat-messages#miniChatBody
        .mini-chat-input-area
          input#miniChatImageInput(type="file", accept="image/*", style="display: none;", onchange="handleMiniChatImageSelect(this)")
          input(type="text", placeholder="Nhập tin nhắn...", id="miniChatInput")
          button(onclick="sendMiniChatMessage()")
            i.fa-solid.fa-paper-plane
          button(onclick="document.getElementById('miniChatImageInput').click()", title="Gửi ảnh")
            i.fa-solid.fa-image
          button.btn-close-chat(onclick="closeMiniChatSession()", title="Đóng chat")
            i.fa-solid.fa-power-off

  script(src="https://cdn.socket.io/4.7.2/socket.io.min.js")
  script(src="/admin/js/chat-page.js")
  script(src="/admin/js/chat-admin-mini.js")

