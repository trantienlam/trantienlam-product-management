extends ../../layouts/default.pug

block styles
  style.
    .accounts-avatar-cell { width: 56px; }
    .accounts-avatar-img {
      width: 48px;
      height: 48px;
      object-fit: cover;
      border-radius: 50%;
      border: 1px solid #e9ecef;
      display: block;
    }
    .accounts-avatar-placeholder {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #e9ecef;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6c757d;
      font-size: 1.25rem;
    }

block main
  if(role.permission.includes("accounts_view"))
    h1(class="mb-4") Danh sách tài khoản 
    .card.mb-3 
      .card-header Danh sách 
      .card-body 
        .row 
          .col-8 
          .col-4.text-right 
            if(role.permission.includes("accounts_create"))
              a(
                href=`${prefixAdmin}/accounts/create`
                class="btn btn-outline-success"
              ) + Thêm mới

        table(
          class="table table-hover table-sm"
        )
          thead 
            tr 
              th STT 
              th Avatar 
              th Họ tên 
              th Phân quyền 
              th email 
              th Trạng thái 
              th Hành động
          tbody 
            each item, index in records 
              tr 
                td #{index+1}
                td.accounts-avatar-cell
                  if item.avatarUrl
                    img.accounts-avatar-img(
                      src=item.avatarUrl
                      alt=item.fullName
                      onerror="this.style.display='none';var n=this.nextElementSibling;if(n)n.style.display='flex';"
                    )
                    .accounts-avatar-placeholder(style="display:none")
                      i.fa-solid.fa-user
                  else
                    .accounts-avatar-placeholder
                      i.fa-solid.fa-user
                td #{item.fullName}
                td #{item.role.title}
                td #{item.email} 
                td 
                  if(role.permission.includes("accounts_change_status"))
                    if (item.status == "active")
                      a(
                        href="javascript:;"
                        class="badge badge-success"
                        data-status="active"
                        button-change-status
                        data-id=item.id
                      ) Hoạt động
                    else
                      a(
                        href="javascript:;"
                        class="badge badge-danger"
                        data-status="inactive"
                        button-change-status
                        data-id=item.id
                      ) Dừng hoạt động
                td 
                  a(
                    class="btn btn-secondary btn-sm"
                    href=`${prefixAdmin}/accounts/detail/${item.id}`
                  ) Chi tiết 
                  if(role.permission.includes("accounts_edit"))
                    a(
                      class="btn btn-warning btn-sm ml-1"
                      href=`${prefixAdmin}/accounts/edit/${item.id}`
                    ) Sửa
                  if(role.permission.includes("accounts_delete")) 
                    button(
                      class="btn btn-danger btn-sm ml-1"
                      button-delete
                      data-id=item._id

                    ) Xóa

    form(
      action=""
      method="POST"
      id="form-change-status"
      data-path=`${prefixAdmin}/accounts/change-status`
      )

    form(
      action=""
      method="POST"
      id ="form-delete-item"
      data-path=`${prefixAdmin}/accounts/delete`
    ) 

  script(src="/admin/js/product.js") 