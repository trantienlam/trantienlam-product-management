extends ../../layouts/default.pug
include ../../mixins/alert.pug

block styles
  style.
    .edit-profile-page {
      padding: 24px 0;
      min-height: calc(100vh - 56px);
      background: #f1f5f9;
    }

    .edit-card {
      background: #fff;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
      max-width: 720px;
      margin: 0 auto;
    }

    /* Cover */
    .edit-cover {
      height: 140px;
      background: linear-gradient(135deg, #4a90d9 0%, #357abd 50%, #234e8f 100%);
      position: relative;
    }
    .edit-cover::after {
      content: '';
      position: absolute;
      inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    /* Avatar edit */
    .edit-avatar-section {
      position: relative;
      padding: 0 32px;
      margin-top: -56px;
      z-index: 1;
      display: flex;
      align-items: flex-end;
      gap: 20px;
      margin-bottom: 8px;
    }
    .edit-avatar-wrapper {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 4px solid #fff;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      background: #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .edit-avatar-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .edit-avatar-wrapper i {
      font-size: 40px;
      color: #94a3b8;
    }
    .edit-avatar-hint {
      padding-bottom: 8px;
      font-size: 13px;
      color: #64748b;
    }
    .edit-avatar-hint small {
      display: block;
      color: #94a3b8;
      margin-top: 2px;
    }

    /* Form */
    .edit-form-section {
      padding: 8px 32px 32px;
    }

    .form-group {
      margin-bottom: 20px;
    }
    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #374151;
      margin-bottom: 6px;
    }
    .form-control {
      width: 100%;
      padding: 10px 14px;
      font-size: 14px;
      color: #1e293b;
      background: #f8fafc;
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      transition: all 0.2s;
      outline: none;
      box-sizing: border-box;
    }
    .form-control:focus {
      background: #fff;
      border-color: #4a90d9;
      box-shadow: 0 0 0 3px rgba(74, 144, 217, 0.12);
    }
    .form-control::placeholder {
      color: #94a3b8;
    }

    /* Avatar upload */
    .upload-wrapper {
      position: relative;
      display: inline-flex;
      flex-direction: column;
      gap: 8px;
    }
    .upload-wrapper label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: #f1f5f9;
      border: 1.5px dashed #cbd5e1;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      color: #4a90d9;
      cursor: pointer;
      transition: all 0.2s;
    }
    .upload-wrapper label:hover {
      background: #dbeafe;
      border-color: #4a90d9;
    }
    .upload-wrapper input[type="file"] {
      display: none;
    }
    .upload-preview {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #e2e8f0;
      margin-top: 4px;
      display: none;
    }
    .upload-preview[src]:not([src=""]) {
      display: block;
    }

    /* Hint text */
    .form-hint {
      font-size: 12px;
      color: #94a3b8;
      margin-top: 4px;
    }

    /* Actions */
    .edit-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 8px;
      border-top: 1px solid #f1f5f9;
      margin-top: 8px;
    }
    .edit-actions .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 20px;
      font-size: 14px;
      font-weight: 600;
      color: #64748b;
      background: #f1f5f9;
      border-radius: 10px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .edit-actions .btn-back:hover {
      background: #e2e8f0;
      color: #374151;
    }
    .edit-actions .btn-save {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 28px;
      font-size: 14px;
      font-weight: 600;
      color: #fff;
      background: linear-gradient(135deg, #4a90d9, #357abd);
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 2px 8px rgba(74, 144, 217, 0.3);
    }
    .edit-actions .btn-save:hover {
      background: linear-gradient(135deg, #357abd, #234e8f);
      box-shadow: 0 4px 12px rgba(74, 144, 217, 0.4);
      transform: translateY(-1px);
    }

    @media (max-width: 600px) {
      .edit-avatar-section {
        flex-direction: column;
        align-items: flex-start;
        padding: 0 16px;
      }
      .edit-form-section { padding: 8px 16px 24px; }
      .edit-actions { flex-direction: column-reverse; gap: 12px; }
      .edit-actions .btn-back,
      .edit-actions .btn-save { width: 100%; justify-content: center; }
    }

block main
  .edit-profile-page
    .edit-card
      //- Cover
      .edit-cover

      //- Avatar edit
      .edit-avatar-section
        .edit-avatar-wrapper
          if user.avatar
            img(src=user.avatar alt=user.fullName id="currentAvatarPreview")
          else
            i.fa-solid.fa-user
        .edit-avatar-hint
          strong Chỉnh sửa ảnh đại diện
          small JPG, PNG, GIF, WEBP — tối đa 5MB

      //- Form
      .edit-form-section
        +alert-success(5000)
        +alert-error(5000)

        form(
          action=`${prefixAdmin}/my-account/edit?_method=PATCH`
          method="POST"
          enctype="multipart/form-data"
        )
          .form-group
            label(for="fullName") Họ tên
            input.form-control(
              type="text"
              id="fullName"
              name="fullName"
              required
              placeholder="Nhập họ tên của bạn"
              value=user.fullName
            )

          .form-group
            label(for="email") Email
            input.form-control(
              type="email"
              id="email"
              name="email"
              required
              placeholder="Nhập địa chỉ email"
              value=user.email
            )

          .form-group
            label(for="phone") Số điện thoại
            input.form-control(
              type="text"
              id="phone"
              name="phone"
              placeholder="Nhập số điện thoại"
              value=user.phone
            )

          .form-group
            label(for="password") Mật khẩu mới
            input.form-control(
              type="password"
              id="password"
              name="password"
              placeholder="Để trống nếu không đổi mật khẩu"
            )
            .form-hint Để trống nếu bạn không muốn thay đổi mật khẩu

          .form-group
            label Ảnh đại diện
            .upload-wrapper
              label(for="avatar")
                i.fa-solid.fa-cloud-arrow-up.me-1
                | Chọn ảnh mới
              input.form-control(
                type="file"
                id="avatar"
                name="avatar"
                accept="image/*"
                onchange="previewAvatar(this)"
              )
              img#avatarPreview.upload-preview(
                src=user.avatar || ""
                alt="Avatar preview"
              )

          .edit-actions
            a.btn-back(href=`${prefixAdmin}/my-account`)
              i.fa-solid.fa-arrow-left
              | Quay lại
            button.btn-save(type="submit")
              i.fa-solid.fa-check
              | Lưu thay đổi

  script.
    function previewAvatar(input) {
      const preview = document.getElementById('avatarPreview');
      const wrapper = document.querySelector('.edit-avatar-wrapper');
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          preview.src = e.target.result;
          preview.style.display = 'block';
          if (wrapper) {
            const oldImg = wrapper.querySelector('img');
            const oldIcon = wrapper.querySelector('i');
            if (oldImg) oldImg.remove();
            if (oldIcon) oldIcon.remove();
            const img = document.createElement('img');
            img.src = e.target.result;
            img.alt = 'Avatar';
            wrapper.appendChild(img);
          }
        };
        reader.readAsDataURL(input.files[0]);
      }
    }
