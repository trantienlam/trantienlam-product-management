extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  .edit-profile-page
    .edit-card
      //- Cover
      .edit-cover

      //- Avatar edit
      .edit-avatar-section
        .edit-avatar-wrapper
          if user.avatar
            img(src=user.avatar alt=user.fullName id="currentAvatarPreview")
          else
            i.fa-solid.fa-user
        .edit-avatar-hint
          strong Chỉnh sửa ảnh đại diện
          small JPG, PNG, GIF, WEBP — tối đa 5MB

      //- Form
      .edit-form-section
        +alert-success(5000)
        +alert-error(5000)

        form(
          action=`${prefixAdmin}/my-account/edit?_method=PATCH`
          method="POST"
          enctype="multipart/form-data"
        )
          .form-group
            label(for="fullName") Họ tên
            input.form-control(
              type="text"
              id="fullName"
              name="fullName"
              required
              placeholder="Nhập họ tên của bạn"
              value=user.fullName
            )

          .form-group
            label(for="email") Email
            input.form-control(
              type="email"
              id="email"
              name="email"
              required
              placeholder="Nhập địa chỉ email"
              value=user.email
            )

          .form-group
            label(for="phone") Số điện thoại
            input.form-control(
              type="text"
              id="phone"
              name="phone"
              placeholder="Nhập số điện thoại"
              value=user.phone
            )

          .form-group
            label(for="password") Mật khẩu mới
            input.form-control(
              type="password"
              id="password"
              name="password"
              placeholder="Để trống nếu không đổi mật khẩu"
            )
            .form-hint Để trống nếu bạn không muốn thay đổi mật khẩu

          .form-group
            label Ảnh đại diện
            .upload-wrapper
              label(for="avatar")
                i.fa-solid.fa-cloud-arrow-up.me-1
                | Chọn ảnh mới
              input.form-control(
                type="file"
                id="avatar"
                name="avatar"
                accept="image/*"
                onchange="previewAvatar(this)"
              )
              img#avatarPreview.upload-preview(
                src=user.avatar || ""
                alt="Avatar preview"
              )

          .edit-actions
            a.btn-back(href=`${prefixAdmin}/my-account`)
              i.fa-solid.fa-arrow-left
              | Quay lại
            button.btn-save(type="submit")
              i.fa-solid.fa-check
              | Lưu thay đổi

append scripts
  script(src="/admin/js/my-account-edit.js")
