extends ../../layouts/default.pug

block main
  .profile-page
    .profile-card
      //- Cover
      .profile-cover

      //- Avatar + Name
      .profile-avatar-section
        .profile-avatar-wrapper
          if user.avatar
            img(src=user.avatar alt=user.fullName)
          else
            i.fa-solid.fa-user
        .profile-name-block
          h2= user.fullName || "Không có tên"
          if role && role.title
            span.role-badge
              i.fa-solid.fa-shield-halved.me-1
              | #{role.title}

      //- Info
      .profile-info-section
        .profile-section-title Thông tin cá nhân

        .profile-info-grid
          .profile-info-item
            .profile-info-icon.name
              i.fa-solid.fa-user
            div
              .profile-info-label Họ tên
              .profile-info-value= user.fullName || "—"

          .profile-info-item
            .profile-info-icon.email
              i.fa-solid.fa-envelope
            div
              .profile-info-label Email
              .profile-info-value= user.email || "—"

          .profile-info-item
            .profile-info-icon.phone
              i.fa-solid.fa-phone
            div
              .profile-info-label Số điện thoại
              .profile-info-value= user.phone || "—"

          .profile-info-item
            .profile-info-icon.status
              i.fa-solid.fa-circle-check
            div
              .profile-info-label Trạng thái
              .profile-info-value(class=user.status === "active" ? "status-active" : "status-inactive")
                if user.status === "active"
                  i.fa-solid.fa-circle.me-1(style="font-size:8px")
                  | Hoạt động
                else
                  i.fa-solid.fa-circle.me-1(style="font-size:8px")
                  | Dừng hoạt động

          if role && role.title
            .profile-info-item
              .profile-info-icon.role
                i.fa-solid.fa-shield-halved
              div
                .profile-info-label Phân quyền
                .profile-info-value= role.title

      //- Action
      .profile-action
        a.btn-edit-profile(
          href=`${prefixAdmin}/my-account/edit`
        )
          i.fa-solid.fa-pen-to-square.me-2
          | Chỉnh sửa thông tin
