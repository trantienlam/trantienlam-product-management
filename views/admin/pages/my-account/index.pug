extends ../../layouts/default.pug

block styles
  style.
    .profile-page {
      padding: 24px 0;
      min-height: calc(100vh - 56px);
      background: #f1f5f9;
    }

    .profile-card {
      background: #fff;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
      max-width: 820px;
      margin: 0 auto;
    }

    /* Cover banner */
    .profile-cover {
      height: 160px;
      background: linear-gradient(135deg, #4a90d9 0%, #357abd 50%, #234e8f 100%);
      position: relative;
    }
    .profile-cover::after {
      content: '';
      position: absolute;
      inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    /* Avatar section */
    .profile-avatar-section {
      position: relative;
      padding: 0 32px;
      margin-top: -60px;
      z-index: 1;
    }

    .profile-avatar-wrapper {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      border: 5px solid #fff;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      background: #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: center;
      float: left;
    }
    .profile-avatar-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .profile-avatar-wrapper i {
      font-size: 48px;
      color: #94a3b8;
    }

    .profile-name-block {
      float: left;
      margin-left: 24px;
      margin-top: 48px;
    }
    .profile-name-block h2 {
      font-size: 22px;
      font-weight: 700;
      color: #1e293b;
      margin: 0 0 4px;
    }
    .profile-name-block .role-badge {
      display: inline-block;
      background: #dbeafe;
      color: #1d4ed8;
      font-size: 12px;
      font-weight: 600;
      padding: 3px 12px;
      border-radius: 20px;
    }

    /* Info section */
    .profile-info-section {
      padding: 24px 32px 32px;
      clear: both;
    }

    .profile-section-title {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #94a3b8;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .profile-section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #e2e8f0;
    }

    .profile-info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 16px;
    }

    .profile-info-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 16px;
      background: #f8fafc;
      border-radius: 12px;
      border: 1px solid #f1f5f9;
      transition: all 0.2s;
    }
    .profile-info-item:hover {
      border-color: #cbd5e1;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .profile-info-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 16px;
    }
    .profile-info-icon.name   { background: #dbeafe; color: #2563eb; }
    .profile-info-icon.email  { background: #fce7f3; color: #db2777; }
    .profile-info-icon.phone  { background: #d1fae5; color: #059669; }
    .profile-info-icon.status { background: #fef3c7; color: #d97706; }
    .profile-info-icon.role   { background: #ede9fe; color: #7c3aed; }

    .profile-info-label {
      font-size: 11px;
      color: #94a3b8;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 3px;
    }
    .profile-info-value {
      font-size: 15px;
      font-weight: 600;
      color: #1e293b;
    }

    .status-active  { color: #059669; }
    .status-inactive { color: #dc2626; }

    /* Action */
    .profile-action {
      text-align: center;
      padding: 24px 32px 32px;
      border-top: 1px solid #f1f5f9;
    }

    @media (max-width: 600px) {
      .profile-name-block { float: none; margin-left: 0; margin-top: 12px; }
      .profile-avatar-wrapper { float: none; margin: 0 auto; }
      .profile-info-section { padding: 20px 16px 24px; }
      .profile-action { padding: 20px 16px 24px; }
    }

block main
  .profile-page
    .profile-card
      //- Cover
      .profile-cover

      //- Avatar + Name
      .profile-avatar-section
        .profile-avatar-wrapper
          if user.avatar
            img(src=user.avatar alt=user.fullName)
          else
            i.fa-solid.fa-user
        .profile-name-block
          h2= user.fullName || "Không có tên"
          if role && role.title
            span.role-badge
              i.fa-solid.fa-shield-halved.me-1
              | #{role.title}

      //- Info
      .profile-info-section
        .profile-section-title Thông tin cá nhân

        .profile-info-grid
          .profile-info-item
            .profile-info-icon.name
              i.fa-solid.fa-user
            div
              .profile-info-label Họ tên
              .profile-info-value= user.fullName || "—"

          .profile-info-item
            .profile-info-icon.email
              i.fa-solid.fa-envelope
            div
              .profile-info-label Email
              .profile-info-value= user.email || "—"

          .profile-info-item
            .profile-info-icon.phone
              i.fa-solid.fa-phone
            div
              .profile-info-label Số điện thoại
              .profile-info-value= user.phone || "—"

          .profile-info-item
            .profile-info-icon.status
              i.fa-solid.fa-circle-check
            div
              .profile-info-label Trạng thái
              .profile-info-value(class=user.status === "active" ? "status-active" : "status-inactive")
                if user.status === "active"
                  i.fa-solid.fa-circle.me-1(style="font-size:8px")
                  | Hoạt động
                else
                  i.fa-solid.fa-circle.me-1(style="font-size:8px")
                  | Dừng hoạt động

          if role && role.title
            .profile-info-item
              .profile-info-icon.role
                i.fa-solid.fa-shield-halved
              div
                .profile-info-label Phân quyền
                .profile-info-value= role.title

      //- Action
      .profile-action
        a.btn-edit-profile(
          href=`${prefixAdmin}/my-account/edit`
        )
          i.fa-solid.fa-pen-to-square.me-2
          | Chỉnh sửa thông tin
