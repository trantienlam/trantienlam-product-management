extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)

  .page-header
    .container
      .page-header__content
        .page-header__left
          .page-header__icon
            i.fa-solid.fa-chart-column
          .page-header__text
            h1 Báo cáo doanh thu
            p Thống kê doanh thu và sản phẩm đã bán theo ngày, tháng, năm

  .container
    .report-overview.report-overview--modern.mb-4
      .report-overview__header
        .report-overview__title-wrap
          .report-overview__title-icon
            i.fa-solid.fa-chart-line
          h3 Báo cáo doanh thu & sản phẩm đã bán
          span.report-overview__hint Dữ liệu đơn đã thanh toán
        form(method="GET" action=`${prefixAdmin}/reports`)
          .report-filter
            label.report-filter__label(for="reportType")
              i.fa-solid.fa-calendar-days.me-1
              | Xem theo
            select#reportType.report-filter__select(name="reportType" onchange="this.form.submit()")
              option(value="day" selected=salesReport.reportType === "day") Theo ngày
              option(value="month" selected=salesReport.reportType === "month") Theo tháng
              option(value="year" selected=salesReport.reportType === "year") Theo năm

      .row
        .col-md-4.mb-3
          .report-mini-card.report-mini-card--day
            .report-mini-card__badge
              i.fa-solid.fa-sun
              | Hôm nay
            .report-mini-card__value.text-success= salesReport.summary.day.revenue.toLocaleString("vi-VN") + " đ"
            .report-mini-card__sub
              i.fa-solid.fa-boxes-stacked.me-1
              | Đã bán #{salesReport.summary.day.soldQuantity} sản phẩm
        .col-md-4.mb-3
          .report-mini-card.report-mini-card--month
            .report-mini-card__badge
              i.fa-solid.fa-calendar
              | Tháng này
            .report-mini-card__value.text-info= salesReport.summary.month.revenue.toLocaleString("vi-VN") + " đ"
            .report-mini-card__sub
              i.fa-solid.fa-boxes-stacked.me-1
              | Đã bán #{salesReport.summary.month.soldQuantity} sản phẩm
        .col-md-4.mb-3
          .report-mini-card.report-mini-card--year
            .report-mini-card__badge
              i.fa-solid.fa-calendar-check
              | Năm này
            .report-mini-card__value.text-primary= salesReport.summary.year.revenue.toLocaleString("vi-VN") + " đ"
            .report-mini-card__sub
              i.fa-solid.fa-boxes-stacked.me-1
              | Đã bán #{salesReport.summary.year.soldQuantity} sản phẩm

      .report-table-card
        .table-responsive
          table.table.table-hover.mb-0.report-table
            thead.thead-light
              tr
                th Kỳ báo cáo
                th.text-right Sản phẩm đã bán
                th.text-right Doanh thu
            tbody
              if salesReport.rows && salesReport.rows.length > 0
                each row in salesReport.rows
                  tr
                    td
                      span.report-period-badge= row.label
                    td.text-right
                      span.report-sold-pill= row.soldQuantity.toLocaleString("vi-VN")
                    td.text-right.font-weight-bold.text-danger= row.revenue.toLocaleString("vi-VN") + " đ"
              else
                tr
                  td.text-center.text-muted(colspan="3") Chưa có dữ liệu báo cáo.
