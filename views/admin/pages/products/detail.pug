extends ../../layouts/default.pug

block main
  .page-header.page-header-product
    .container
      .page-header-content
        .page-header-icon
          i.fa-solid.fa-box-open
        .page-header-text
          h1.page-title Chi tiết sản phẩm
          p.page-subtitle Xem thông tin chi tiết và quản lý sản phẩm

  .container-fluid.py-4
    .row

      //- Left: Hình ảnh & Thumbnail chính
      .col-lg-5.mb-4
        .product-gallery-card
          .product-gallery-header
            i.fa-solid.fa-images
            span Hình ảnh sản phẩm
          .product-gallery-body
            if(product.images && product.images.length > 0)
              .product-images-grid
                each img in product.images
                  img.product-detail-img(src=img alt=product.title)
            else if(product.thumbnail)
              .product-main-image
                img(src=product.thumbnail alt=product.title)
            else
              .product-no-image
                i.fa-solid.fa-image
                span Chưa có hình ảnh

      //- Right: Thông tin sản phẩm
      .col-lg-7
        .product-info-card.mb-4
          .product-info-header
            i.fa-solid.fa-info-circle
            h3 Thông tin cơ bản
          .product-info-body
            .row
              .col-md-12.mb-3
                .product-title-block
                  h2.product-title= product.title
                  if(product.status === "active")
                    span.product-status-badge.status-active
                      i.fa-solid.fa-check-circle
                      | Đang bán
                  else
                    span.product-status-badge.status-inactive
                      i.fa-solid.fa-ban
                      | Ngừng bán

              .col-md-6.mb-3
                .product-info-item
                  .product-info-label
                    i.fa-solid.fa-tag
                    | Giá gốc
                  .product-info-value.product-price-old
                    if(product.price)
                      | #{product.price.toLocaleString("vi-VN")} đ
                    else
                      span.text-muted Chưa cập nhật

              .col-md-6.mb-3
                .product-info-item
                  .product-info-label
                    i.fa-solid.fa-money-bill-wave
                    | Giá bán
                  .product-info-value
                    if(product.price)
                      | #{product.price.toLocaleString("vi-VN")} đ
                    else
                      span.text-muted Chưa cập nhật

              .col-md-6.mb-3
                .product-info-item
                  .product-info-label
                    i.fa-solid.fa-warehouse
                    | Số lượng tồn kho
                  .product-info-value
                    if(product.stock)
                      span.stock-badge(class=product.stock < 10 ? "stock-low" : "")
                        i.fa-solid.fa-boxes-stacked
                        | #{product.stock} sản phẩm
                    else
                      span.text-muted Chưa cập nhật

              .col-md-6.mb-3
                .product-info-item
                  .product-info-label
                    i.fa-solid.fa-layer-group
                    | Vị trí hiển thị
                  .product-info-value
                    if(product.position)
                      | ##{product.position}
                    else
                      span.text-muted Chưa cập nhật

              .col-md-6.mb-3
                .product-info-item
                  .product-info-label
                    i.fa-solid.fa-star
                    | Sản phẩm nổi bật
                  .product-info-value
                    if(product.featured === "1")
                      span.featured-badge
                        i.fa-solid.fa-star
                        | Nổi bật
                    else
                      span.text-muted Không

              .col-md-6.mb-3
                .product-info-item
                  .product-info-label
                    i.fa-solid.fa-folder
                    | Danh mục
                  .product-info-value
                    if(product.category)
                      a.category-badge(href=`${prefixAdmin}/product-category/detail/${product.category._id}`)
                        i.fa-solid.fa-folder-open
                        | #{product.category.title}
                    else
                      span.text-muted Chưa phân loại

              .col-md-6.mb-3
                .product-info-item
                  .product-info-label
                    i.fa-solid.fa-link
                    | Slug (URL)
                  .product-info-value.product-slug= product.slug || "—"

        //- Mô tả sản phẩm
        if(product.description)
          .product-info-card.mb-4
            .product-info-header
              i.fa-solid.fa-align-left
              h3 Mô tả sản phẩm
            .product-info-body
              .product-description !{product.description}

        //- Thông tin người tạo & cập nhật
        .product-info-card.mb-4
          .product-info-header
            i.fa-solid.fa-user-pen
            h3 Người tạo & cập nhật
          .product-info-body
            .row
              .col-md-6.mb-3
                .user-info-block
                  .user-info-icon.bg-green
                    i.fa-solid.fa-user-plus
                  .user-info-content
                    .user-info-label Người tạo
                    .user-info-value= (product.creator && product.creator.fullName) || "—"
                    if(product.createdBy && product.createdBy.createdAt)
                      .user-info-date
                        i.fa-solid.fa-calendar-plus
                        | #{product.createdBy.createdAt.toLocaleDateString("vi-VN")}

              .col-md-6.mb-3
                .user-info-block
                  .user-info-icon.bg-blue
                    i.fa-solid.fa-pen-to-square
                  .user-info-content
                    .user-info-label Cập nhật lần cuối
                    .user-info-value= (product.lastUpdater && product.lastUpdater.fullName) || "—"
                    if(product.lastUpdatedAt)
                      .user-info-date
                        i.fa-solid.fa-clock
                        | #{product.lastUpdatedAt.toLocaleDateString("vi-VN")}

        //- Lịch sử cập nhật (nếu có)
        if(product.updatedBy && product.updatedBy.length > 0)
          .product-info-card.mb-4
            .product-info-header
              i.fa-solid.fa-clock-rotate-left
              h3 Lịch sử cập nhật (#{product.updatedBy.length})
            .product-info-body
              - const updateHistoryPreview = product.updatedBy.slice().reverse().slice(0, 5)
              - const updateHistoryTotal = product.updatedBy.length
              .update-history-list
                each item, index in updateHistoryPreview
                  - const updateOrdinal = updateHistoryTotal - index
                  .update-history-item
                    .update-history-index #{updateOrdinal}
                    .update-history-content
                      .update-history-title Cập nhật lần #{updateOrdinal}
                      if(item.updatedAt)
                        .update-history-date
                          i.fa-solid.fa-calendar
                          | #{item.updatedAt.toLocaleDateString("vi-VN")} lúc #{item.updatedAt.toLocaleTimeString("vi-VN")}
                    .update-history-action
                      i.fa-solid.fa-pencil.text-primary

        //- Nút hành động
        .action-buttons
          a.btn.btn-warning(
            href=`${prefixAdmin}/products/edit/${product._id}`
          )
            i.fa-solid.fa-pen-to-square
            | Chỉnh sửa sản phẩm

          a.btn.btn-secondary(
            href=`${prefixAdmin}/products`
          )
            i.fa-solid.fa-arrow-left
            | Quay lại danh sách
