doctype html
html
  head
    title #{pageTitle}

    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")

    link(rel="stylesheet", href="/admin/css/style.css")
    link(rel="stylesheet", href="/admin/css/admin.css")
    link(rel="stylesheet", href="/admin/css/sidebar.css")

    block styles
  
  body.admin-layout

    if(role.permission.length > 0)
      .admin-sidebar-overlay#adminSidebarOverlay

      .admin-layout-wrapper
        include ../partials/sider.pug 

        .admin-main
          .admin-mobile-header.d-lg-none
            button.admin-mobile-menu-btn#adminMobileMenuBtn
              i.fa-solid.fa-bars
          
          block main
    
      script(src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js") 
      script(src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js") 
      script(src="/tinymce/tinymce.min.js")
      script(src="/admin/js/tinymce-config.js")
      script(src="/admin/js/script.js")

      block scripts

    else 
      .container.py-5
        h1.text-center Bạn không có quyền truy cập
