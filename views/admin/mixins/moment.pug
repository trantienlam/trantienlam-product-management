

mixin formatDateTime(time)
  - const d = time ? new Date(time) : null
  - const valid = d && !isNaN(d.getTime())
  span #{valid ? moment(d).format('DD/MM/YYYY HH:mm:ss') : 'N/A'}

mixin formatDate(time)
  - const d = time ? new Date(time) : null
  - const valid = d && !isNaN(d.getTime())
  span #{valid ? moment(d).format('DD/MM/YYYY') : 'N/A'}

mixin formatTime(time)
  - const d = time ? new Date(time) : null
  - const valid = d && !isNaN(d.getTime())
  span #{valid ? moment(d).format('HH:mm:ss') : 'N/A'}
